#!/bin/bash -l
#
# 2026-09 point-source CPU speed-up campaign, phase 4b: the step-0 containment
# route A/B (PyAutoArray#579) on RAL CPU.
#
# WHAT THIS MEASURES. scripts/point_source_image/likelihood_breakdown/
# solver_config_sweep.py --step0-route control,gather,components,structured:
# the production FitPositionsImagePairAllSolved likelihood at the production
# geometry (+-9.9" / 0.2 / 1e-3 / MCS 15) with autoarray's _STEP0_CONTAINMENT
# set per route for tracing only (fresh closure + jax.clear_caches() per route),
# interleaved 20 rounds x 20 calls, bootstrap 90 % CI, vmap 1/4/16, compile_s,
# XLA memory, the route-aware step-0 prefix split, the 200 prior + 200 stress
# completeness draws, and gates.step0_route_bit_identity (stream / fiducial /
# prior log L, prior + stress positions, image counts, grad, vmap bit-identical
# to the control). "control" is the branch's library default ("structured");
# "gather" is the pre-#579 general path, i.e. the "before".
#
# LIBRARY. The branch is unpushed, so its PyAutoArray is a git clone of the
# shared mirror with the branch fetched from a bundle, checked out detached at
# the measured commit (AA_BRANCH_SRC below), prepended to PYTHONPATH. Every
# other library is the shared mirror (/mnt/ral/jnightin/PyAuto, via
# activate.sh); PyAutoLens is mirror main 4487eb47, unchanged by #579. The job
# refuses to run unless autoarray imports from the clone and the rest from the
# mirror, and asserts the JSON source_revisions afterwards.
#
# THREADS. OMP/MKL/OPENBLAS pinned to 1 (BLAS family only); the JAX CPU backend
# sizes its Eigen pool from the 8 CPUs of --cpus-per-task=8, as phases 1-4a.
# XLA_FLAGS are the phase-1 row's, byte for byte.
#
# NODE. Pinned to the Xeon Platinum 8490H node of phase 4a (euclid-ral-compute-10-4,
# jobs 356365 / 356367). Check `sinfo -p ral -N -o "%N %T %C"` first: `idle*`
# nodes are unreachable.

# WALL-BASIS:
#   RAL job 357321 (this cell, --step0-route control,gather,components,structured,
#   8490H euclid-ral-compute-10-4 under load ~200, 8 CPUs, 200 + 200 draws, 20 x 20)
#   ran 480 s (8:08 job wall). Headroom 3 covers a quieter or busier node.
#   cell: point_source_image/solver_config_sweep/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 480  ref: ral-job-357321-point_source_image-solver_config_sweep  headroom: 3.0

#SBATCH -J point_source_step0_p4b
#SBATCH --partition=ral
#SBATCH --nodelist=euclid-ral-compute-10-4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=1:30:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export AA_BRANCH_SRC="${AA_BRANCH_SRC:-/mnt/ral/jnightin/autolens_profiling_wt/PyAutoArray_pointsolver-step0-gather}"
if [ ! -f "$AA_BRANCH_SRC/autoarray/__init__.py" ]; then
    echo "FATAL: $AA_BRANCH_SRC is not a PyAutoArray checkout (see LIBRARY)" >&2
    exit 2
fi
export PYTHONPATH="$AA_BRANCH_SRC:$PYTHONPATH"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent compile cache: compile_s is a gate and must be cold per route.
unset JAX_COMPILATION_CACHE_DIR

CONFIG_NAME=hpc_ral_cpu_fp64
RESULTS_DIR=$AP_ROOT/results/breakdown/point_source_image
mkdir -p "$RESULTS_DIR"

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "sched_affinity: $(python3 -c 'import os; print(len(os.sched_getaffinity(0)))')"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cell:           point_source_image/likelihood_breakdown/solver_config_sweep --step0-route"
echo "Thread env:     OMP=$OMP_NUM_THREADS MKL=$MKL_NUM_THREADS OPENBLAS=$OPENBLAS_NUM_THREADS NPROC=$NPROC"
echo "XLA_FLAGS:      $XLA_FLAGS"
echo "PYTHONPATH:     $PYTHONPATH"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r (mirror)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "PyAutoArray (branch clone, IMPORTED): $(git -C $AA_BRANCH_SRC rev-parse HEAD 2>&1)"
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance ==="
python3 - <<'PYEOF' || exit 3
import os, autoarray, autofit, autogalaxy, autolens, jax, jaxlib, numpy
aa = os.path.realpath(os.environ["AA_BRANCH_SRC"])
for m in (autoarray, autofit, autogalaxy, autolens):
    print(f"{m.__name__:<11} {m.__version__:<12} {m.__file__}")
if not os.path.realpath(autoarray.__file__).startswith(aa + "/"):
    raise SystemExit(f"REFUSING: autoarray from {autoarray.__file__}, not {aa}")
for m in (autofit, autogalaxy, autolens):
    if not m.__file__.startswith("/mnt/ral/jnightin/PyAuto/"):
        raise SystemExit(f"REFUSING: {m.__name__} from {m.__file__}, not the shared mirror")
from autoarray.structures.triangles import array as a
print("_STEP0_CONTAINMENT", a._STEP0_CONTAINMENT)
print("jax", jax.__version__, "jaxlib", jaxlib.__version__, "numpy", numpy.__version__, jax.devices())
PYEOF

echo "=========================================="
echo "RUN ${CONFIG_NAME} -> ${RESULTS_DIR}"
date
echo "loadavg: $(cat /proc/loadavg)"
PYTHONUNBUFFERED=1 python3 scripts/point_source_image/image_plane/solver_config_sweep.py \
    --config-name "$CONFIG_NAME" --output-dir "$RESULTS_DIR" \
    --step0-route control,gather,components,structured \
    --n-draws 200 --n-stress 200 --rounds 20 --calls 20

echo "=== source_revisions check (JSON vs imported HEADs) ==="
python3 - "$RESULTS_DIR/solver_config_sweep_step0_${CONFIG_NAME}.json" <<'PYEOF'
import json, os, subprocess, sys
path = sys.argv[1]
d = json.load(open(path))
revs = d["source_revisions"]
def head(p):
    return subprocess.check_output(["git", "-C", p, "rev-parse", "HEAD"], text=True).strip()
want = {r: head(f"/mnt/ral/jnightin/PyAuto/{r}") for r in ("PyAutoNerves", "PyAutoFit", "PyAutoGalaxy", "PyAutoLens")}
want["PyAutoArray"] = head(os.environ["AA_BRANCH_SRC"])
for r, h in want.items():
    if revs[r] != h:
        raise SystemExit(f"MISMATCH {path}: {r} JSON {revs[r]} != {h}")
subprocess.check_call(["git", "-C", os.environ["AA_BRANCH_SRC"], "merge-base", "--is-ancestor",
                       "c13b2d733538bec86cff3a15eccd9a0940a68463", revs["PyAutoArray"]])
print("autoarray_imported_from", d.get("autoarray_imported_from"))
print("OK", path, "all_gates_pass", d.get("all_gates_pass"))
PYEOF

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
echo "Finished."
date
