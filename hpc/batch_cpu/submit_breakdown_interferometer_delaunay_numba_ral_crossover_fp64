#!/bin/bash -l
#
# RAL CPU in-situ crossover: interferometer/delaunay_numba, numba direct_conv vs NumPy FFT
# through the LIBRARY DISPATCH across mask radius (autolens_profiling#332, interferometer
# likelihood campaign 3/3, phase 2). One array task per (instrument, mask radius):
#
#   0 sma r3.5 | 1 alma r2.0 | 2 alma r3.5 | 3 alma r4.25 | 4 alma r5.0 | 5 alma r6.0 | 6 alma_high r3.5
#
# nnz/col grows with the mask radius at a fixed pixel scale (~10 at alma r2.0 -> ~120 at
# alma_high r3.5), so the numba / FFT full-call ratio sweeps through 1. Radii chosen from
# the 2026-09-27 laptop calibration probe on the cached library (alma r5.0: Delaunay
# nnz/col 55.6 ratio 1.04, rectangular 82.7 ratio 1.08, laptop at load ~4.4) scaled by the
# phase-1 RAL/laptop F-alone ratio, so that every crossover in r3.5-6.0 is bracketed by two
# measured radii for both meshes.
#
# The r3.5 tasks (0, 2, 6) re-run the phase-1 rows under their original names on PyAutoArray
# main >= e281abf3 (#582, cached F / D; the folded-in sparse-cache after-measurement): the
# harness carries the replaced row's full calls into previous_row (the before/after delta)
# and the witness is evaluations_per_figure_of_merit {1, 1} + the sma pins. Other radii write
# _r<radius> names. The adapt image is the May-18 lensed_source.fits cache (md5 recorded in
# adapt_image; a missing cache at a non-preset radius is a hard error). The W~ preload is
# cached per (shape, radius) beside the dataset, written atomically (concurrent tasks safe).
#
# SINGLE-THREAD SCOPE (the #235 discipline): NUMBA_NUM_THREADS=1, BLAS family 1, memo off;
# --cpus-per-task=4 is headroom for the one process, not a thread budget.
#
# PARTITION: `gpu` with NO --gres (CPUs only; #265 quiet-host precedent), <= 8 CPUs and the
# array throttled to %2 (RAL partition rule, hpc/README.md). Host name and
# host_load_avg_* are recorded per task; tasks may share a node.
#
# WALL-BASIS:
#   cell: interferometer/delaunay_numba/sma  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 240  headroom: 1.25  ref: RAL_job_357557_#326_phase1_sma_incl_JAX_leg_pre_cache
#   cell: interferometer/delaunay_numba/alma  device: ral_cpu  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 1500  headroom: 3.0  ref: laptop_2026-09-27_#332_alma_r5.0_probe_3_instances_scaled_to_20_at_r6.0
#   cell: interferometer/delaunay_numba/alma_high  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 1316  headroom: 1.25  ref: RAL_job_357556_#326_phase1_alma_high_incl_JAX_leg_pre_cache
#
# Output (per task):
#   results/breakdown/interferometer/[<instrument>/]delaunay_numba_hpc_ral_cpu_fp64[_r<radius>].{json,png}
#
# Submit from hpc/batch_cpu/ (the -o/-e paths are relative).

#SBATCH -J bd_intf_del_nb_xo
#SBATCH --partition=gpu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32gb
#SBATCH --time=2:00:00
#SBATCH --array=0-6%2
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

INSTRUMENTS=(sma alma alma alma alma alma alma_high)
RADII=(3.5 2.0 3.5 4.25 5.0 6.0 3.5)
TASK=${SLURM_ARRAY_TASK_ID:-0}
INSTRUMENT=${INSTRUMENTS[$TASK]}
RADIUS=${RADII[$TASK]}

export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PROJECT_PATH="$AP_ROOT"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMBA_NUM_THREADS=1
export JAX_PLATFORMS=cpu
export JAX_PLATFORM_NAME=cpu
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1 --xla_disable_hlo_passes=constant_folding"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
unset JAX_COMPILATION_CACHE_DIR

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "nodelist:       ${SLURM_JOB_NODELIST:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Task:           $TASK -> $INSTRUMENT r$RADIUS"
echo "Thread env:     OMP=$OMP_NUM_THREADS MKL=$MKL_NUM_THREADS OPENBLAS=$OPENBLAS_NUM_THREADS NUMBA=$NUMBA_NUM_THREADS"

echo "=== source revisions (shared mirror) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C $PYAUTO_HPC_BASE/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:    $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance + dependency floors ==="
python3 -c "
import importlib.metadata as m, os, autoarray, autolens, numba
for mod in (autoarray, autolens):
    print(f'{mod.__name__}.__file__ =', mod.__file__)
    assert os.path.realpath(mod.__file__).startswith(os.path.realpath(os.environ['PYAUTO_HPC_BASE'])), f'{mod.__name__} not from the shared mirror'
print('numba', numba.__version__, 'nufftax', m.version('nufftax'))
assert tuple(int(x) for x in m.version('nufftax').split('.')[:2]) >= (0, 6), 'nufftax below the 0.6.1 floor'
from autoarray.inversion.inversion.interferometer.sparse import InversionInterferometerSparse as S
assert not isinstance(S.__dict__['curvature_matrix_diag'], property), 'PyAutoArray predates e281abf3 (#582)'
" || exit 3

echo "=========================================="
echo "NumPy arms (numba direct_conv + NumPy FFT) -- delaunay_numba.py $INSTRUMENT r$RADIUS"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/interferometer/likelihood_breakdown/delaunay_numba.py \
    --instrument $INSTRUMENT \
    --mask-radius $RADIUS \
    --config-name hpc_ral_cpu_fp64 \
    --n-instances 20

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
echo "Finished."
date
