#!/bin/bash -l
#
# Critical-curves campaign, autolens_profiling#521: zero-contour feasibility for modeling-run
# visualization, CPU fp64, one array task per leg.
#
# WHAT THIS MEASURES. scripts/lens/critical_curves/modeling_viz_feasibility_scales.py rebuilds
# tracers from phase-4 autolens_inference posterior draws (max likelihood + 10 weighted draws per
# leg) and, per draw, times the production critical-curve path with marching squares vs
# zero-contour and grades both against a fine marching-squares reference (pre-registered rule
# in modeling_viz_feasibility.py). Galaxy/group use _compute_critical_curve_lines; cluster uses
# point_sources.curves_for_planes vs per-plane LensCalc zero-contour (auto and reference-seeded).
#
# CORPUS. scripts/lens/critical_curves/viz_feasibility_legs.json: 17 legs, one per
# (scale, likelihood family, variant), CPU-backend seed_0 (seeds/backends share a posterior).
# Array index = position in that file. Samples are read in place from the phase-4 output under
# /mnt/ral/jnightin/inference/autolens_inference (read only).
#
# LIBRARY CODE. A PRIVATE checkout of the five libraries ($PYAUTO_PRIVATE_BASE) at the SHAs the
# laptop pilots ran (release 2026.11.6.1 mains). Prepended to PYTHONPATH; the job refuses to run if
# any library imports from elsewhere. The shared /mnt/ral/jnightin/PyAuto mirror is never used.
#
# NODE. `ral` only (CPU work never goes on `gpu`), exclusive per task so cold/warm timings are not
# shared with other jobs, throttled to 5 concurrent tasks. Check `sinfo -p ral -N -o "%N %T %C"`.
#
# WALL-BASIS:
#   Laptop pilots 2026-11-06 (8 CPU, fp64): interferometer/sma 6 draws 222-482 s; group ML draw
#   253 s (incl. repeat + reused-calc legs); cluster ML draw 145 s. 11 draws, x headroom ~3 ->
#   at most ~1 h per task; --time 3 h, harness per-leg cap 7200 s.

#SBATCH -J cc_viz_feasibility
#SBATCH --partition=ral
#SBATCH --exclusive
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64gb
#SBATCH --time=3:00:00
#SBATCH --array=0-16%5
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err

# Submit from hpc/batch_cpu/ (the -o/-e paths are relative).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PYAUTO_PRIVATE_BASE="${PYAUTO_PRIVATE_BASE:-/mnt/ral/jnightin/PyAuto_wt/critical-curves-jax-viz-feasibility}"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh
export PYTHONPATH=$PYAUTO_PRIVATE_BASE/PyAutoNerves:$PYAUTO_PRIVATE_BASE/PyAutoFit:$PYAUTO_PRIVATE_BASE/PyAutoArray:$PYAUTO_PRIVATE_BASE/PyAutoGalaxy:$PYAUTO_PRIVATE_BASE/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export MPLBACKEND=Agg
export MPLCONFIGDIR=$AP_ROOT/output/mpl_${SLURM_JOB_ID:-local}
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
unset JAX_COMPILATION_CACHE_DIR PYAUTO_SMALL_DATASETS PYAUTO_FAST_PLOTS

cd $AP_ROOT
python3 - <<'EOF'
import os, autoarray, autofit, autogalaxy, autolens, autonerves
base = os.path.realpath(os.environ["PYAUTO_PRIVATE_BASE"])
for m in (autoarray, autofit, autogalaxy, autolens, autonerves):
    path = os.path.realpath(m.__file__)
    if not path.startswith(base + os.sep):
        raise SystemExit(f"REFUSING: {m.__name__} imports from {path}, not {base}")
    print(m.__name__, path)
import importlib.metadata as md
print({k: md.version(k) for k in ("jax", "jaxlib", "jax_zero_contour", "numpy", "scikit-image")})
EOF

python3 scripts/lens/critical_curves/modeling_viz_feasibility_scales.py \
    --run results/lens/critical_curves/viz_feasibility/ral_cpu \
    --selected scripts/lens/critical_curves/viz_feasibility_legs.json \
    --samples-root /mnt/ral/jnightin/inference/autolens_inference/ \
    --classes imaging,interferometer,group,cluster \
    --draws 10 \
    --index ${SLURM_ARRAY_TASK_ID}

python3 - <<EOF
import json, pathlib, sys
legs = json.loads(pathlib.Path("scripts/lens/critical_curves/viz_feasibility_legs.json").read_text())
leg = legs[${SLURM_ARRAY_TASK_ID}]
name = leg["record"].replace("results/", "").replace("/stages.json", "").replace("/", "__")
out = pathlib.Path("results/lens/critical_curves/viz_feasibility/ral_cpu") / f"{name}.json"
if not out.exists() or not json.loads(out.read_text()).get("complete"):
    sys.exit(f"INCOMPLETE: {out} (see the leg .log next to it)")
print("complete", out)
EOF
echo "Finished."
date
