#!/bin/bash -l
#
# RAL CPU array: the matrix-free rectangular experiment (35x35 everywhere, alma scan).
# Likelihood-lifecycle phase 2b interferometer campaign (autolens_profiling#469), matrix-free experiment: 7 leg(s).
# GENERATED by scripts/misc/campaigns/interferometer_p2b.py --write; edit the generator,
# not this file (the campaign test fails on a hand edit). The batch procedure is in
# scripts/misc/campaigns/README.md.
#
# LIBRARY CODE. UNRELEASED library main: a private checkout ($MF_PRIVATE_BASE, default
# /mnt/ral/jnightin/profiling/PyAuto_main_7eba0c07) whose five HEADs must be the declared SHAs
# (interferometer_p2b.MF_LIBRARY_SHAS; PyAutoArray#658 matrix-free route) is prepended
# to PYTHONPATH over the shared venv ($PYAUTO_HPC_BASE, default /mnt/ral/jnightin/PyAuto). The job
# refuses to run on any other HEAD or import origin, and checks each row's
# library_revisions after its leg. The shared mirror is never pulled or used.
#
# ROWS. Experiments only, never current: 35x35 rows go to the cell's
# experiments/numpy_cpu_matrixfree/ folder, the alma mesh scan to
# scans/numpy_cpu_matrixfree_<N>x<N>/, under the gitignored output/p2b_matrixfree/ tree.
#
# MEMORY. --mem=128gb, a declared estimate: the dense fft-route reference at
# 192x192 holds F and H of ~11 GB each, and jvla's mapping matrix and preload.
# One leg per array task on `ral` (CPU work never goes on `gpu`). numba legs pin their
# BLAS and numba threads to 1; JAX CPU legs get NPROC=8.
#
# WALL-BASIS: nothing measured on this route yet; 14000 s per leg is a declared guess
# (3x floor).
#   4 leg(s): rectangular numba_cpu_sparse_fp64_wtilde runtime, rectangular numba_cpu_sparse_fp64_wtilde runtime, rectangular numba_cpu_sparse_fp64_wtilde runtime, rectangular numba_cpu_sparse_fp64_wtilde runtime
#   cell: interferometer/pixelization_matrixfree/alma  device: ral_cpu  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 14000  headroom: 3.0
#   1 leg(s): rectangular numba_cpu_sparse_fp64_wtilde runtime
#   cell: interferometer/pixelization_matrixfree/alma_high  device: ral_cpu  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 14000  headroom: 3.0
#   1 leg(s): rectangular numba_cpu_sparse_fp64_wtilde runtime
#   cell: interferometer/pixelization_matrixfree/jvla  device: ral_cpu  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 14000  headroom: 3.0
#   1 leg(s): rectangular numba_cpu_sparse_fp64_wtilde runtime
#   cell: interferometer/pixelization_matrixfree/sma  device: ral_cpu  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 14000  headroom: 3.0

#SBATCH -J p2b_matrixfree_ral_cpu
#SBATCH --partition=ral
#SBATCH --array=0-6%16
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128gb
#SBATCH --time=12:00:00
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err

# Submit from hpc/batch_cpu/ or hpc/batch_gpu/ (the -o/-e paths are relative).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
export PYAUTO_PRIVATE_BASE="${MF_PRIVATE_BASE:-/mnt/ral/jnightin/profiling/PyAuto_main_7eba0c07}"
export P2B_PIN=main-unreleased
echo "AP_ROOT=$AP_ROOT  PYAUTO_PRIVATE_BASE=$PYAUTO_PRIVATE_BASE  pin=$P2B_PIN"
source "$AP_ROOT/activate.sh"
export PYTHONPATH=$PYAUTO_PRIVATE_BASE/PyAutoNerves:$PYAUTO_PRIVATE_BASE/PyAutoFit:$PYAUTO_PRIVATE_BASE/PyAutoArray:$PYAUTO_PRIVATE_BASE/PyAutoGalaxy:$PYAUTO_PRIVATE_BASE/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMBA_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_ENABLE_X64=True
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
unset PYAUTO_SMALL_DATASETS
export NUMBA_CACHE_DIR="$AP_ROOT/output/numba_cache/p2b_${SLURM_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}"
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR" "$AP_ROOT/output/p2b_logs"

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition: ${SLURM_JOB_PARTITION:-unset}  nodelist: ${SLURM_JOB_NODELIST:-unset}  cpus: ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:   $(cat /proc/loadavg)"
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s %s\n' "$r" "$(git -C $PYAUTO_PRIVATE_BASE/$r rev-parse HEAD 2>&1)" "$(git -C $PYAUTO_PRIVATE_BASE/$r describe --tags 2>&1)"
done
echo "AP_ROOT rev: $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd "$AP_ROOT"
# The libraries must import from the private checkout at the declared main SHAs, never the shared mirror.
python3 - <<'EOF_PY' || exit 3
import os, subprocess
import autoarray, autofit, autogalaxy, autolens, autonerves
base = os.path.realpath(os.environ["PYAUTO_PRIVATE_BASE"])
shas = {"PyAutoNerves": "ec8b5c1e5f17ac03ac5246b5fbc322624a6cd3f6", "PyAutoFit": "8740092dc12b809847be07255ff427b50eae059e", "PyAutoArray": "7eba0c07872a6c83ac2d12a72c4b6613cb3b6a0f", "PyAutoGalaxy": "a1080929d52e5f2546adf8583b4b21040b201c13", "PyAutoLens": "a8eb094e539185ea2485beda25e7411df176da65"}
for m in (autonerves, autofit, autoarray, autogalaxy, autolens):
    print(f"{m.__name__:<11} {m.__file__}")
    if not os.path.realpath(m.__file__).startswith(base + os.sep):
        raise SystemExit(f"REFUSING: {m.__name__} imported from {m.__file__}, not {base}")
    repo = os.path.dirname(os.path.dirname(os.path.realpath(m.__file__)))
    head = subprocess.check_output(["git", "-C", repo, "rev-parse", "HEAD"], text=True).strip()
    want = shas[os.path.basename(repo)]
    if head != want:
        raise SystemExit(f"REFUSING: {repo} is at {head}, not the declared main SHA {want}")
print("import origin + declared main SHAs: OK")
EOF_PY

# After each leg: the row's recorded library revisions must be the private checkout's HEADs.
check_revisions() {
python3 - "$1" <<'EOF_PY'
import json, os, subprocess, sys
path = sys.argv[1]
revs = json.load(open(path))["device"]["provenance"]["library_revisions"]
base = os.environ["PYAUTO_PRIVATE_BASE"]
for repo in ("PyAutoNerves", "PyAutoFit", "PyAutoArray", "PyAutoGalaxy", "PyAutoLens"):
    head = subprocess.check_output(["git", "-C", f"{base}/{repo}", "rev-parse", "HEAD"], text=True).strip()
    if revs.get(repo) != head:
        raise SystemExit(f"MISMATCH {path}: {repo} row {revs.get(repo)} != private checkout {head}")
print("revisions OK", path)
EOF_PY
}

# Simulate a missing dataset and cache its adapt image once per instrument, under a lock.
prepare_dataset() {
python3 - "$1" <<'EOF_PY'
import sys
sys.path.insert(0, "scripts/misc/campaigns")
from interferometer_p2b import prepare_dataset
prepare_dataset(sys.argv[1])
EOF_PY
}

# One leg: fresh JAX compile cache, the leg's platform, wall clock logged, revisions checked.
# A failed leg is recorded and the job carries on (|| keeps activate.sh's ERR trap out of it).
STATUS=0
run_leg() {
    local I=$1
    local LOG="$AP_ROOT/output/p2b_logs/submit_campaign_p2b_matrixfree_ral_cpu_fp64_${SLURM_JOB_ID:-local}_${I}.log"
    export JAX_PLATFORMS=${PLATFORMS[$I]}
    export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/p2b_${SLURM_JOB_ID:-local}_${I}"
    rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
    prepare_dataset ${INSTS[$I]} || { echo "LEG $I: dataset preparation FAILED"; STATUS=5; return 0; }
    echo "------------------------------------------"
    echo "LEG $I: ${CELLNAMES[$I]}"
    echo "  cell script: scripts/${CELLS[$I]}.py ${FLAGS[$I]} -> $RESULTS_ROOT/${OUTS[$I]}"
    echo "  JAX_PLATFORMS=$JAX_PLATFORMS  NPROC=$NPROC  log=$LOG"
    local T0=$(date +%s)
    # A START line first, so a leg killed at --time (which never reaches its WALL line) still shows.
    printf 'START\t%s\t%s\t%s\t%s\n' "${SLURM_JOB_ID:-local}" "$I" "$T0" "${CELLNAMES[$I]}" >> "$AP_ROOT/output/p2b_logs/walls.tsv"
    python3 -u scripts/${CELLS[$I]}.py --instrument ${INSTS[$I]} ${FLAGS[$I]} --output-path "$RESULTS_ROOT/${OUTS[$I]}" > "$LOG" 2>&1 \
        || { echo "LEG $I FAILED (rc $?), see $LOG"; tail -20 "$LOG"; STATUS=4; }
    local WALL=$(( $(date +%s) - T0 ))
    printf 'WALL\t%s\t%s\t%s\t%s\n' "${SLURM_JOB_ID:-local}" "$I" "$WALL" "${CELLNAMES[$I]}" | tee -a "$AP_ROOT/output/p2b_logs/walls.tsv"
    if [ -f "$RESULTS_ROOT/${OUTS[$I]}" ]; then
        check_revisions "$RESULTS_ROOT/${OUTS[$I]}" || STATUS=4
    else
        echo "LEG $I: no row at $RESULTS_ROOT/${OUTS[$I]}"; STATUS=4
    fi
}

