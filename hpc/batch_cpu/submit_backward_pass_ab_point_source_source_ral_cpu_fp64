#!/bin/bash -l
#
# 2026-09 source-plane point-source campaign, phase 2b (autolens_profiling#325):
# RAL CPU row for the backward-pass A/B. Single-source only (the `simple`
# dataset); nothing under scripts/cluster/.
#
# WHAT THIS MEASURES. One cell, one process, on ONE pinned RAL CPU node:
#
#   scripts/point_source_source/likelihood_breakdown/backward_pass_ab.py
#      Interleaved A/B of how the gradient of the fused FitPositionsSourceSolved
#      (solved lane) and FitPositionsSource (plain lane) likelihoods is computed:
#      rev (jax.value_and_grad, production) vs fwd (jax.jacfwd over the 5/7
#      scalar leaves, value as aux) vs rev_jacrev (Hessian by jax.jacrev) vs
#      rev_analytic / fwd_analytic (closed-form SIE Hessian kappa +- gamma_1,
#      gamma_2), all prototyped inside the cell by a scoped monkeypatch of
#      LensCalc._hessian_via_jax (no library edit). A correctness gate runs
#      before any timing (analytic/jacrev vs jacfwd Hessian rtol 1e-10 at the
#      dataset, near-critical and perturbed-model sets; log L rtol 1e-10 and
#      gradient rtol 1e-8 vs rev, finite and non-zero, over PRNGKey 0..15; eager
#      == JIT); a failing route is reported and never timed. 20 rounds x 20
#      calls, route order rotated each round. The phase-2c go/no-go (saved
#      >= 0.05 ms AND >= 15 % vs rev, 90 % CIs excluding the bar, gate green) is
#      decided on THIS row.
#
# HOST PINNING. euclid-ral-compute-10-2 (Xeon 8490H; phase 2a's host, job
# 356368). On 2026-09-27 `sinfo -p ral -N` showed every 10-* node `mix` and 10-2
# carrying 18 jnightin DR1 array tasks (144/236 CPUs allocated), so the node is
# NOT quiet as it was for phase 2a: the job records loadavg start/end and the
# note says so. The A/B is interleaved in-process, so ratios are robust to a
# steady co-tenant load; absolute ms are load-exposed.
#
# QUIET CROSS-CHECK (same file, command-line override). The gpu partition was
# idle; its host CPUs (AMD EPYC 7702, no --gres) give a quiet second CPU row:
#   AB_CONFIG_NAME=hpc_ral_gpunode_cpu_fp64 sbatch --export=ALL \
#     --partition=gpu --nodelist=euclid-ral-gpu-2 submit_backward_pass_ab_point_source_source_ral_cpu_fp64
#
# LIBRARY. The shared /mnt/ral/jnightin/PyAuto stack is used AS-IS (no feature
# branch prepend). On 2026-09-27 it matched the local mains exactly for
# PyAutoFit cf83504e / PyAutoArray 14d63360 / PyAutoGalaxy 0e4b89cf /
# PyAutoLens 4487eb47 (PyAutoNerves 2b3bc533, two tooling-only commits behind
# the local eb27da24). The job echoes the HEADs and the JSON records
# source_revisions.
#
# THREADS. OMP/MKL/OPENBLAS pinned to 1 (BLAS family only); the JAX CPU pool
# sizes from the 8 CPUs of --cpus-per-task=8. The JSON records
# thread_environment, sched_affinity, os_cpu_count, cpu_model, loadavg start/end
# and the process thread count after the first compile.
#
# Writes results/breakdown/point_source_source/backward_pass_ab_hpc_ral_cpu_fp64.{json,png}.
# Pull with `hpc/sync pull` or scp; copy output/output.<id>.out by hand to
# results/notes/point_source_source_plane_2026_09_27_ral_job_<id>.out
# (known gap: `hpc/sync pull` does not fetch batch_cpu logs).
#
# WALL-BASIS:
#   Laptop witness (WSL2, 8 threads): backward_pass_ab.py at 20 x 20 527 s process
#   wall, most of it the eager Hessian gate. x 2.0 headroom, inside 1 h.
#   cell: point_source_source/backward_pass_ab/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 527  ref: laptop-backward_pass_ab_local_cpu_fp64  headroom: 2.0

#SBATCH -J backward_pass_p2b
#SBATCH --partition=ral
#SBATCH --nodelist=euclid-ral-compute-10-2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=1:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Repo root from where this was submitted (hpc/batch_cpu/../..), so it runs from
# a worktree of the feature branch. sbatch from inside hpc/batch_cpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent JAX compile cache: compile times are recorded and must be cold.
unset JAX_COMPILATION_CACHE_DIR
AB_CONFIG_NAME=${AB_CONFIG_NAME:-hpc_ral_cpu_fp64}

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "nodelist:       ${SLURM_JOB_NODELIST:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "sched_affinity: $(python3 -c 'import os; print(len(os.sched_getaffinity(0)))')"
echo "loadavg:        $(cat /proc/loadavg)"
echo "config name:    $AB_CONFIG_NAME"
echo "Cell:           point_source_source/likelihood_breakdown/backward_pass_ab"
echo "Precision:      fp64 (JAX_ENABLE_X64=$JAX_ENABLE_X64)"
echo "Thread env:     OMP=$OMP_NUM_THREADS MKL=$MKL_NUM_THREADS OPENBLAS=$OPENBLAS_NUM_THREADS NPROC=$NPROC"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r (shared)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance (refuses unless the libraries come from the shared stack) ==="
python3 -c "
import os, autoarray, autolens, autofit, autogalaxy, jax
for m in (autoarray, autolens, autofit, autogalaxy):
    print(f'{m.__name__}.__file__ =', m.__file__)
    assert os.path.realpath(m.__file__).startswith('/mnt/ral/jnightin/PyAuto/'), f'{m.__name__} not from the shared stack'
print('jax', jax.__version__, jax.devices(), jax.default_backend())
assert jax.default_backend() == 'cpu', 'JAX is not on the CPU'
print('ASSERT OK: CPU backend, libraries from /mnt/ral/jnightin/PyAuto')
" || exit 3

echo "=========================================="
echo "backward-pass A/B (20 x 20)"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/point_source_source/likelihood_breakdown/backward_pass_ab.py --config-name $AB_CONFIG_NAME --rounds 20 --calls 20

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
echo "Finished."
date
