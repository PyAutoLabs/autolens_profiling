#!/bin/bash -l
#
# Likelihood-lifecycle phase 6 gradient campaign (autolens_profiling#507, #509): 9 leg(s) from
# the interferometer_p2b runtime cells, RAL CPU.
# GENERATED by scripts/misc/campaigns/gradient_p6.py --write; edit the generator,
# not this file (the campaign test fails on a hand edit). A run needs the human's go.
#
# LIBRARY CODE. A private checkout of the five libraries at the day-zero tag 2026.10.25.1
# ($PYAUTO_PRIVATE_BASE, default /mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1) is prepended to PYTHONPATH over the
# shared venv ($PYAUTO_HPC_BASE, default /mnt/ral/jnightin/PyAuto). The job refuses to run if a
# library imports from anywhere else or sits at another tag, and after each leg it checks
# the witness's library_revisions equal the checkout's HEADs.
#
# CELLS. Each leg runs the likelihood's gradient_breakdown.py with the flags of the cell's
# phase-2 runtime leg: the runtime script builds its own fused likelihood and, with
# --gradient, hands it to scripts/misc/gradient/harness.py (forward vs value_and_grad, the
# pre-registered finite-difference check and FD step sweep) instead of timing it. It writes
# gradient.json (witness version 2)
# into the mirrored cell named by --output-path under the gitignored output/p6_gradient/
# scratch tree, never in place over committed rows. fp64 only.
#
# MEMORY. --mem=128gb, the phase-2 source campaign's declared value for these cells.
#
# WALL-BASIS: a measured row cites the first run's wall of its legs (the slowest; array
# tasks) plus 78 forward calls of the FD step sweep at the cell's measured
# forward time. An unmeasured row is a leg the first run did not finish: a declared guess,
# 4x the cell's measured phase-2 runtime wall (at least 1200 s),
# with the 3x floor. The legs' walls land in output/p6_gradient_logs/walls.tsv.
#   2 leg(s): delaunay jax_cpu_sparse_fp64_wtilde gradient, rectangular jax_cpu_sparse_fp64_wtilde gradient
#   cell: interferometer/gradient_breakdown/alma  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 343  ref: 413719_0,413719_5  measured-on: alma  headroom: 1.25  median: included
#   2 leg(s): delaunay jax_cpu_sparse_fp64_wtilde gradient, rectangular jax_cpu_sparse_fp64_wtilde gradient
#   cell: interferometer/gradient_breakdown/alma_high  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 1127  ref: 413719_1,413719_6  measured-on: alma_high  headroom: 1.25  median: included
#   2 leg(s): delaunay jax_cpu_sparse_fp64_wtilde gradient, rectangular jax_cpu_sparse_fp64_wtilde gradient
#   cell: interferometer/gradient_breakdown/jvla  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 6792  ref: 413719_2,413719_7  measured-on: jvla  headroom: 1.25  median: included
#   3 leg(s): delaunay jax_cpu_sparse_fp64_wtilde gradient, mge jax_cpu_dense_fp64_nufft gradient, rectangular jax_cpu_sparse_fp64_wtilde gradient
#   cell: interferometer/gradient_breakdown/sma  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 379  ref: 413719_3,413719_4,413719_8  measured-on: sma  headroom: 1.25  median: included

#SBATCH -J p6_interferometer_ral_cpu
#SBATCH --partition=ral
#SBATCH --array=0-8%8
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128gb
#SBATCH --time=3:00:00
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err

# Submit from hpc/batch_cpu/ or hpc/batch_gpu/ (the -o/-e paths are relative).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
export PYAUTO_PRIVATE_BASE="${PYAUTO_PRIVATE_BASE:-/mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1}"
export P6_PIN=2026.10.25.1
echo "AP_ROOT=$AP_ROOT  PYAUTO_PRIVATE_BASE=$PYAUTO_PRIVATE_BASE  pin=$P6_PIN"
source "$AP_ROOT/activate.sh"
export PYTHONPATH=$PYAUTO_PRIVATE_BASE/PyAutoNerves:$PYAUTO_PRIVATE_BASE/PyAutoFit:$PYAUTO_PRIVATE_BASE/PyAutoArray:$PYAUTO_PRIVATE_BASE/PyAutoGalaxy:$PYAUTO_PRIVATE_BASE/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMBA_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_ENABLE_X64=True
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
# XLA:CPU deadlock workaround (autolens_profiling#473, D12): jaxlib 0.11.2 XLA:CPU executables can
# hang on a repeated call; run_leg appends this to XLA_FLAGS on every JAX_PLATFORMS=cpu leg (A100
# nodes' CPU legs included), never on a GPU leg. Rows record it in device.xla_flags.
XLA_FLAGS_BASE="$XLA_FLAGS"
XLA_CPU_WORKAROUND_FLAG="--xla_cpu_multi_thread_eigen=false"
unset PYAUTO_SMALL_DATASETS
export NUMBA_CACHE_DIR="$AP_ROOT/output/numba_cache/p6_${SLURM_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}"
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR" "$AP_ROOT/output/p6_gradient_logs"

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition: ${SLURM_JOB_PARTITION:-unset}  nodelist: ${SLURM_JOB_NODELIST:-unset}  cpus: ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:   $(cat /proc/loadavg)"
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s %s\n' "$r" "$(git -C $PYAUTO_PRIVATE_BASE/$r rev-parse HEAD 2>&1)" "$(git -C $PYAUTO_PRIVATE_BASE/$r describe --tags 2>&1)"
done
echo "AP_ROOT rev: $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd "$AP_ROOT"
# The libraries must import from the private checkout at the pinned tag, never the shared mirror.
python3 - <<'EOF_PY' || exit 3
import os, subprocess
import autoarray, autofit, autogalaxy, autolens, autonerves
base, pin = os.path.realpath(os.environ["PYAUTO_PRIVATE_BASE"]), os.environ["P6_PIN"]
for m in (autonerves, autofit, autoarray, autogalaxy, autolens):
    print(f"{m.__name__:<11} {m.__file__}")
    if not os.path.realpath(m.__file__).startswith(base + os.sep):
        raise SystemExit(f"REFUSING: {m.__name__} imported from {m.__file__}, not {base}")
    repo = os.path.dirname(os.path.dirname(os.path.realpath(m.__file__)))
    tag = subprocess.check_output(["git", "-C", repo, "describe", "--tags"], text=True).strip()
    if tag != pin:
        raise SystemExit(f"REFUSING: {repo} is at {tag}, not tag {pin}")
print(f"import origin + tag {pin}: OK")
EOF_PY

# After each leg: the row's recorded library revisions must be the private checkout's HEADs.
check_revisions() {
python3 - "$1" <<'EOF_PY'
import json, os, subprocess, sys
path = sys.argv[1]
revs = json.load(open(path))["device"]["provenance"]["library_revisions"]
base = os.environ["PYAUTO_PRIVATE_BASE"]
for repo in ("PyAutoNerves", "PyAutoFit", "PyAutoArray", "PyAutoGalaxy", "PyAutoLens"):
    head = subprocess.check_output(["git", "-C", f"{base}/{repo}", "rev-parse", "HEAD"], text=True).strip()
    if revs.get(repo) != head:
        raise SystemExit(f"MISMATCH {path}: {repo} row {revs.get(repo)} != private checkout {head}")
print("revisions OK", path)
EOF_PY
}

# Simulate a missing dataset and cache its adapt image once per instrument, under a lock.
prepare_dataset() {
python3 - "$1" <<'EOF_PY'
import sys
sys.path.insert(0, "scripts/misc/campaigns")
from interferometer_p2b import prepare_dataset
prepare_dataset(sys.argv[1])
EOF_PY
}

# One leg: fresh JAX compile cache, the leg's platform, wall clock logged, revisions checked.
# A failed leg is recorded and the job carries on (|| keeps activate.sh's ERR trap out of it).
STATUS=0
run_leg() {
    local I=$1
    local LOG="$AP_ROOT/output/p6_gradient_logs/submit_campaign_p6_gradient_interferometer_ral_cpu_fp64_${SLURM_JOB_ID:-local}_${I}.log"
    export JAX_PLATFORMS=${PLATFORMS[$I]}
    if [ "$JAX_PLATFORMS" = cpu ]; then
        export XLA_FLAGS="$XLA_FLAGS_BASE $XLA_CPU_WORKAROUND_FLAG"
    else
        export XLA_FLAGS="$XLA_FLAGS_BASE"
    fi
    export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/p6_${SLURM_JOB_ID:-local}_${I}"
    rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
    prepare_dataset ${INSTS[$I]} || { echo "LEG $I: dataset preparation FAILED"; STATUS=5; return 0; }
    echo "------------------------------------------"
    echo "LEG $I: ${CELLNAMES[$I]}"
    echo "  cell script: scripts/${CELLS[$I]}.py ${FLAGS[$I]} -> $RESULTS_ROOT/${OUTS[$I]}"
    echo "  JAX_PLATFORMS=$JAX_PLATFORMS  NPROC=$NPROC  log=$LOG"
    echo "  XLA_FLAGS=$XLA_FLAGS"
    local T0=$(date +%s)
    # A START line first, so a leg killed at --time (which never reaches its WALL line) still shows.
    printf 'START\t%s\t%s\t%s\t%s\n' "${SLURM_JOB_ID:-local}" "$I" "$T0" "${CELLNAMES[$I]}" >> "$AP_ROOT/output/p6_gradient_logs/walls.tsv"
    python3 -u scripts/${CELLS[$I]}.py --instrument ${INSTS[$I]} ${FLAGS[$I]} --output-path "$RESULTS_ROOT/${OUTS[$I]}" > "$LOG" 2>&1 \
        || { echo "LEG $I FAILED (rc $?), see $LOG"; tail -20 "$LOG"; STATUS=4; }
    local WALL=$(( $(date +%s) - T0 ))
    printf 'WALL\t%s\t%s\t%s\t%s\n' "${SLURM_JOB_ID:-local}" "$I" "$WALL" "${CELLNAMES[$I]}" | tee -a "$AP_ROOT/output/p6_gradient_logs/walls.tsv"
    if [ -f "$RESULTS_ROOT/${OUTS[$I]}" ]; then
        check_revisions "$RESULTS_ROOT/${OUTS[$I]}" || STATUS=4
    else
        echo "LEG $I: no row at $RESULTS_ROOT/${OUTS[$I]}"; STATUS=4
    fi
}

