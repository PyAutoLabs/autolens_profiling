#!/bin/bash -l
#
# QUIET RERUN, RAL CPU array: the solved hpc_ral_cpu point-source runtime cells.
# Likelihood-lifecycle phase 2c point-source campaign (autolens_profiling#472), quiet rerun: 2 leg(s).
# Human 2026-10-29: "do the reruns now".
# GENERATED by scripts/misc/campaigns/point_source_p2c.py --write; edit the generator, not
# this file (the campaign test fails on a hand edit).
#
# WHY. RAL 413192 ran these two legs (as the solved_runtime experiments of 2f98e01a) beside
# four others on one node, starting at a 1-minute load of 22-33 and writing at 44-54, so the
# dashboard refuses both rows as trend points (hpc/release_sweep.conf
# RELEASE_SWEEP_LOADAVG_CAP=8, judged on the row's loadavg_at_import). This repeats them
# (same scripts, flags, library tag and NPROC=8), each alone on its node.
#
# LIBRARY CODE. A private checkout of the five libraries at tag 2026.10.25.1 ($PYAUTO_PRIVATE_BASE,
# default /mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1) is prepended to PYTHONPATH over the shared venv
# ($PYAUTO_HPC_BASE, default /mnt/ral/jnightin/PyAuto). The job refuses to run if a library imports
# from anywhere else or sits at another tag, and after each leg it checks the row's
# library_revisions equal the checkout's HEADs. AP_ROOT is the checkout this was submitted
# from (hpc/<batch>/../..).
#
# ROWS. Into the gitignored output/p2c_quiet/ tree (logs and walls.tsv in
# output/p2c_quiet_logs/), never over output/p2c/ or committed rows.
#
# MEMORY. --mem=16gb: the laptop smokes peaked at 1.1 GB resident.
# One leg per array task on `ral`, each holding its node exclusively, throttled to
# %2.
#
# WALL-BASIS: measured by RAL 413192. Each leg's wall is its own sacct Elapsed there (under
# load, so an upper bound on a quiet run). --time is 1.25x (the slowest leg,
# 62 s, plus the 1200 s quiet wait) plus 15 min of
# slack, rounded up to the next 30 min.
#   1 leg(s): image_plane jax_cpu_na_fp64 runtime
#   cell: point_source_image/image_plane_solved/simple  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 62  ref: 413192_4  measured-on: simple  headroom: 1.25  median: included
#   1 leg(s): source_plane jax_cpu_na_fp64 runtime
#   cell: point_source_source/source_plane_solved/simple  device: ral_cpu  precision: fp64
#   source: measured-wall  wall: 36  ref: 413192_5  measured-on: simple  headroom: 1.25  median: included

#SBATCH -J p2c_quiet_point_source_ral_cpu
#SBATCH --partition=ral
#SBATCH --array=0-1%2
#SBATCH --exclusive
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16gb
#SBATCH --time=1:00:00
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err

# Submit from hpc/batch_cpu/ or hpc/batch_gpu/ (the -o/-e paths are relative).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
export PYAUTO_PRIVATE_BASE="${PYAUTO_PRIVATE_BASE:-/mnt/ral/jnightin/profiling/PyAuto_2026.10.25.1}"
export P2C_PIN=2026.10.25.1
echo "AP_ROOT=$AP_ROOT  PYAUTO_PRIVATE_BASE=$PYAUTO_PRIVATE_BASE  pin=$P2C_PIN"
source "$AP_ROOT/activate.sh"
export PYTHONPATH=$PYAUTO_PRIVATE_BASE/PyAutoNerves:$PYAUTO_PRIVATE_BASE/PyAutoFit:$PYAUTO_PRIVATE_BASE/PyAutoArray:$PYAUTO_PRIVATE_BASE/PyAutoGalaxy:$PYAUTO_PRIVATE_BASE/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMBA_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_ENABLE_X64=True
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
# XLA:CPU deadlock workaround (autolens_profiling#473, D12): jaxlib 0.11.2 XLA:CPU executables can
# hang on a repeated call; run_leg appends this to XLA_FLAGS on every JAX_PLATFORMS=cpu leg (A100
# nodes' CPU legs included), never on a GPU leg. Rows record it in device.xla_flags.
XLA_FLAGS_BASE="$XLA_FLAGS"
XLA_CPU_WORKAROUND_FLAG="--xla_cpu_multi_thread_eigen=false"
unset PYAUTO_SMALL_DATASETS
export NUMBA_CACHE_DIR="$AP_ROOT/output/numba_cache/p2c_quiet_${SLURM_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}"
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR" "$AP_ROOT/output/p2c_quiet_logs"

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition: ${SLURM_JOB_PARTITION:-unset}  nodelist: ${SLURM_JOB_NODELIST:-unset}  cpus: ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:   $(cat /proc/loadavg)"
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s %s\n' "$r" "$(git -C $PYAUTO_PRIVATE_BASE/$r rev-parse HEAD 2>&1)" "$(git -C $PYAUTO_PRIVATE_BASE/$r describe --tags 2>&1)"
done
echo "AP_ROOT rev: $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd "$AP_ROOT"
# QUIET NODE. This job holds its node exclusively (#SBATCH --exclusive), so the leg is the only
# work on it. Every process is pinned to cores 0..$((SLURM_CPUS_PER_TASK-1)) (taskset), the
# allocation size of the run this repeats, and each leg starts only once the 1-minute load
# average (recorded by the row as loadavg_at_import and refused by the dashboard above
# RELEASE_SWEEP_LOADAVG_CAP) is at most 2: polled every 15 s for at most 1200 s,
# after which the leg runs anyway and its row shows the load it started at.
echo "exclusive: SLURM_JOB_CPUS_PER_NODE=${SLURM_JOB_CPUS_PER_NODE:-unset}  node cpus=$(nproc --all)  cpuset=$(nproc)"
taskset -cp "0-$(( ${SLURM_CPUS_PER_TASK:-8} - 1 ))" $$ \
    || { echo "REFUSING: cannot pin to ${SLURM_CPUS_PER_TASK:-8} cores (is the node exclusive?)"; exit 6; }
quiet_wait() {
    local waited=0 load1
    while :; do
        load1=$(cut -d' ' -f1 /proc/loadavg)
        if awk -v l="$load1" -v m=2 'BEGIN { exit !(l <= m) }'; then
            echo "QUIET: 1-min load $load1 <= 2 after ${waited} s ($(cat /proc/loadavg))"
            return 0
        fi
        if [ "$waited" -ge 1200 ]; then
            echo "QUIET-WAIT TIMEOUT: 1-min load $load1 > 2 after ${waited} s; running anyway"
            return 0
        fi
        sleep 15
        waited=$((waited + 15))
    done
}
# The libraries must import from the private checkout at the pinned tag, never the shared mirror.
python3 - <<'EOF_PY' || exit 3
import os, subprocess
import autoarray, autofit, autogalaxy, autolens, autonerves
base, pin = os.path.realpath(os.environ["PYAUTO_PRIVATE_BASE"]), os.environ["P2C_PIN"]
for m in (autonerves, autofit, autoarray, autogalaxy, autolens):
    print(f"{m.__name__:<11} {m.__file__}")
    if not os.path.realpath(m.__file__).startswith(base + os.sep):
        raise SystemExit(f"REFUSING: {m.__name__} imported from {m.__file__}, not {base}")
    repo = os.path.dirname(os.path.dirname(os.path.realpath(m.__file__)))
    tag = subprocess.check_output(["git", "-C", repo, "describe", "--tags"], text=True).strip()
    if tag != pin:
        raise SystemExit(f"REFUSING: {repo} is at {tag}, not tag {pin}")
print(f"import origin + tag {pin}: OK")
EOF_PY

# After each leg: the row's recorded library revisions must be the private checkout's HEADs.
check_revisions() {
python3 - "$1" <<'EOF_PY'
import json, os, subprocess, sys
path = sys.argv[1]
revs = json.load(open(path))["device"]["provenance"]["library_revisions"]
base = os.environ["PYAUTO_PRIVATE_BASE"]
for repo in ("PyAutoNerves", "PyAutoFit", "PyAutoArray", "PyAutoGalaxy", "PyAutoLens"):
    head = subprocess.check_output(["git", "-C", f"{base}/{repo}", "rev-parse", "HEAD"], text=True).strip()
    if revs.get(repo) != head:
        raise SystemExit(f"MISMATCH {path}: {repo} row {revs.get(repo)} != private checkout {head}")
print("revisions OK", path)
EOF_PY
}

# Simulate a missing dataset and cache its adapt image once per instrument, under a lock.
prepare_dataset() {
python3 - "$1" <<'EOF_PY'
import sys
sys.path.insert(0, "scripts/misc/campaigns")
from point_source_p2c import prepare_dataset
prepare_dataset(sys.argv[1])
EOF_PY
}

# One leg: fresh JAX compile cache, the leg's platform, wall clock logged, revisions checked.
# A failed leg is recorded and the job carries on (|| keeps activate.sh's ERR trap out of it).
STATUS=0
run_leg() {
    local I=$1
    local LOG="$AP_ROOT/output/p2c_quiet_logs/submit_campaign_p2c_quiet_point_source_ral_cpu_fp64_${SLURM_JOB_ID:-local}_${I}.log"
    export JAX_PLATFORMS=${PLATFORMS[$I]}
    if [ "$JAX_PLATFORMS" = cpu ]; then
        export XLA_FLAGS="$XLA_FLAGS_BASE $XLA_CPU_WORKAROUND_FLAG"
    else
        export XLA_FLAGS="$XLA_FLAGS_BASE"
    fi
    export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/p2c_quiet_${SLURM_JOB_ID:-local}_${I}"
    rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
    prepare_dataset ${INSTS[$I]} || { echo "LEG $I: dataset preparation FAILED"; STATUS=5; return 0; }
    echo "------------------------------------------"
    echo "LEG $I: ${CELLNAMES[$I]}"
    echo "  cell script: scripts/${CELLS[$I]}.py ${FLAGS[$I]} -> $RESULTS_ROOT/${OUTS[$I]}"
    echo "  JAX_PLATFORMS=$JAX_PLATFORMS  NPROC=$NPROC  log=$LOG"
    echo "  XLA_FLAGS=$XLA_FLAGS"
    quiet_wait
    local T0=$(date +%s)
    # A START line first, so a leg killed at --time (which never reaches its WALL line) still shows.
    printf 'START\t%s\t%s\t%s\t%s\n' "${SLURM_JOB_ID:-local}" "$I" "$T0" "${CELLNAMES[$I]}" >> "$AP_ROOT/output/p2c_quiet_logs/walls.tsv"
    python3 -u scripts/${CELLS[$I]}.py --instrument ${INSTS[$I]} ${FLAGS[$I]} --output-path "$RESULTS_ROOT/${OUTS[$I]}" > "$LOG" 2>&1 \
        || { echo "LEG $I FAILED (rc $?), see $LOG"; tail -20 "$LOG"; STATUS=4; }
    local WALL=$(( $(date +%s) - T0 ))
    printf 'WALL\t%s\t%s\t%s\t%s\n' "${SLURM_JOB_ID:-local}" "$I" "$WALL" "${CELLNAMES[$I]}" | tee -a "$AP_ROOT/output/p2c_quiet_logs/walls.tsv"
    if [ -f "$RESULTS_ROOT/${OUTS[$I]}" ]; then
        check_revisions "$RESULTS_ROOT/${OUTS[$I]}" || STATUS=4
    else
        echo "LEG $I: no row at $RESULTS_ROOT/${OUTS[$I]}"; STATUS=4
    fi
}

# The manifest: one entry per leg (point_source_p2c.Task).
CELLNAMES=(
    "point_source_image/image_plane/simple jax_cpu_na_fp64@hpc_ral_cpu [runtime]"
    "point_source_source/source_plane/simple jax_cpu_na_fp64@hpc_ral_cpu [runtime]"
)
CELLS=(
    point_source_image/image_plane/likelihood_runtime_solved
    point_source_source/source_plane/likelihood_runtime_solved
)
INSTS=(
    simple
    simple
)
FLAGS=(
    "--config-name hpc_ral_cpu_fp64"
    "--config-name hpc_ral_cpu_fp64"
)
PLATFORMS=(
    cpu
    cpu
)
OUTS=(
    results/point_source_image/image_plane/simple/jax_cpu_na_fp64/hpc_ral_cpu/runtime.json
    results/point_source_source/source_plane/simple/jax_cpu_na_fp64/hpc_ral_cpu/runtime.json
)
RESULTS_ROOT="$AP_ROOT/output/p2c_quiet"

I=${SLURM_ARRAY_TASK_ID:?"submit as an array (sbatch from hpc/<batch>/)"}
run_leg $I

echo "=========================================="
echo "exit status: $STATUS (0 ok, 4 a leg failed or its revisions/row check failed, 5 dataset)"
echo "loadavg: $(cat /proc/loadavg)"
date
exit $STATUS
