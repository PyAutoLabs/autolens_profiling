#!/bin/bash -l
#SBATCH -J fixed_light_numba_s5
#SBATCH --partition=gpu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32gb
#SBATCH --time=2:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
# CPUs only: no GPU allocation. One thread per production likelihood.
# WALL-BASIS: 41 preparations plus 820 likelihood samples and 164 diagnostics;
# two hours includes cold Numba compilation and RAL shared-filesystem imports.
set -euo pipefail
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
source "$AP_ROOT/activate.sh"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1
export NUMBA_CACHE_DIR="$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}"
export MPLCONFIGDIR="/tmp/matplotlib_${SLURM_JOB_ID:-local}"
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
cd "$AP_ROOT"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git rev-parse HEAD
else
    test -f SOURCE_SHA256SUMS
    sha256sum --check SOURCE_SHA256SUMS
fi
hostname
date
python3 -u scripts/imaging/likelihood_breakdown/fixed_light_numba_draws.py \
    --n-repeats 5 --source-pixels 1500 \
    --config-name hpc_ral_cpu_fp64_fixed_light_numba_s5
