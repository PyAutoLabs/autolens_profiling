#!/bin/bash -l
#
# 2026-09 point-source CPU speed-up campaign, phase 1: the RAL CPU baseline
# (autolens_profiling#297).
#
# WHAT THIS MEASURES. The per-call JAX-CPU cost of the two point-source
# image-plane likelihoods the campaign is trying to make cheaper, on a quiet
# RAL CPU node, so every later phase has a baseline that is not a WSL2 laptop:
#
#   Leg A  scripts/point_source/likelihood_breakdown/image_plane.py
#          Galaxy-scale: the production FitPositionsImagePairAllSolved
#          likelihood decomposed into the solved source centre, every
#          PointSolver refinement stage (ray trace / containment / selection /
#          neighbourhood / up-sample per step) and magnification filtering.
#          The authoritative runtimes are fused_full_solved_s and
#          fused_full_plain_control_s; the prefix rows are successive
#          differences and may go slightly negative under XLA fusion.
#
#   Leg B  scripts/cluster/likelihood_breakdown/image_plane.py
#          Cluster-scale: 2 dPIE + 10 scaling dPIE + NFW at z=0.5, sources at
#          z=1.0/2.0, solver grid 200x200 @ 0.7" (precision 0.01"). Per-source
#          JIT PointSolver solves (steps 2.x), eager fit totals (steps 3-4) and
#          the FUSED full likelihoods over all systems, fused_full_plain_s
#          (FitPositionsImagePairRepeat) and fused_full_solved_s
#          (FitPositionsImagePairRepeatSolved), each with its lower / compile /
#          first-call / steady phases under jit_phases. Compile is minutes;
#          the fused rows are what a sampler pays per call.
#
# Both legs write results/breakdown/{point_source,cluster}/
# image_plane_hpc_ral_cpu_fp64.{json,png}. Their laptop counterparts are the
# *_local_cpu_fp64 rows beside them; compare within a host, never a bare
# millisecond across hosts.
#
# THREADS. OMP/MKL/OPENBLAS are pinned to 1 -- that pins the BLAS family only.
# The JAX CPU backend sizes its own intra-op (Eigen) thread pool from the CPUs
# the process can see, i.e. the 8 CPUs of --cpus-per-task=8, so these are
# 8-CPU JAX numbers, the same shape as the laptop's 8-core rows. The JSON's
# thread_environment and device.cpu_count blocks record what was actually seen.
#
# XLA_FLAGS are set IDENTICAL to the local baseline row
# (results/breakdown/point_source/image_plane_local_cpu_fp64.json,
# device.xla_flags). activate.sh sets no XLA_FLAGS / JAX_* of its own, so the
# export below is the only one -- there is nothing to contradict. The two
# --xla_gpu_* flags are inert on CPU and are kept only so the recorded string
# matches the laptop row byte for byte; constant_folding is disabled so a
# constant-foldable prefix cannot be pre-evaluated at compile time.

# THE PARTITION THIS DECLARES, AND THE FALLBACK.
#
# `ral` (the CPU partition) was IDLE when this was planned: 0/252 CPUs
# allocated, load 0.00 on euclid-ral-compute-1..7. It is the partition meant
# for CPU work, so it is what the #SBATCH block below asks for. (It was
# saturated for days in 2026-09-15's fixed-light work -- see the numba
# fixed-light submit beside this one -- so check before you submit.)
#
# Check first:
#
#   sinfo -p ral,gpu -N -o "%N %t %C %O"
#
# If `ral` would queue, the fallback is the gpu partition used CPUs-only, with
# NO --gres so both A100s stay free for the GPU cells:
#
#   sbatch --partition=gpu --cpus-per-task=8 <this script>
#
# `imp` is NOT an option: euclid-imp-compute-* do not mount /mnt/ral, so the
# repo, the venv and activate.sh are absent and the job dies in 0 s.
#
# DECLARE THE PARTITION THAT ACTUALLY RAN. Whichever partition the job landed
# on (the provenance block prints the hostname; `sacct -j <id> -o Partition`
# confirms it) is what the campaign note must report, and if it was the gpu
# fallback this header should be edited to say so -- a script that declares a
# partition its numbers never used is a trap, not a record.

# WALL-BASIS:
#   Laptop (WSL2, 8 cores, 2026-09-23). Point source: the committed
#   image_plane_local_cpu_fp64 row's JIT sections sum to 626 s before its vmap
#   and grad controls, declared here as 1200 s. Cluster: the local witness run
#   of this cell (the committed cluster image_plane_local_cpu_fp64 row) took
#   285 s wall end to end, of which the two fused compiles were ~233 s. The
#   headroom covers a slower RAL core; the family's 4-hour request is kept.
#   cell: point_source/image_plane/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 1200  ref: laptop-point_source-image_plane_local_cpu_fp64  headroom: 2.0
#   cell: cluster/image_plane/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 285  ref: laptop-cluster-image_plane_local_cpu_fp64  headroom: 2.0

#SBATCH -J point_source_breakdown
#SBATCH --partition=ral
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=4:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_cpu/../..)
# rather than hardcoding /mnt/ral/jnightin/autolens_profiling, so it runs from
# a worktree of the feature branch. The -o/-e paths above are relative, so
# sbatch from inside hpc/batch_cpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

# BLAS family only (see THREADS above); JAX's CPU pool sizes from the 8 CPUs.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
# Per-job caches: output/ is gitignored and ${SLURM_JOB_ID} keeps concurrent
# jobs on the same node from fighting over one cache directory.
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# Fresh JAX compile cache per job, as the GPU baseline submits do: a seeded
# persistent cache changes compile times and kernels (results/notes/xla_autotune_triton_gemm.md),
# and RAL $HOME is node-local, so an inherited cache would not be reproducible.
export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/point_source_${SLURM_JOB_ID:-local}"
rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
echo "JAX_COMPILATION_CACHE_DIR=$JAX_COMPILATION_CACHE_DIR (fresh)"

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cells:          point_source/likelihood_breakdown/image_plane, cluster/likelihood_breakdown/image_plane"
echo "Precision:      fp64 (JAX_ENABLE_X64=$JAX_ENABLE_X64)"
echo "Backend:        JAX_PLATFORMS=$JAX_PLATFORMS"
echo "Thread env:     OMP=$OMP_NUM_THREADS MKL=$MKL_NUM_THREADS OPENBLAS=$OPENBLAS_NUM_THREADS NPROC=$NPROC"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions (shared install, untouched) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance ==="
python3 -c "import autoarray, autolens, autofit, autogalaxy, jax; print('autoarray.__file__    =', autoarray.__file__); print('autoarray.__version__ =', autoarray.__version__); print('autolens.__file__     =', autolens.__file__); print('autolens.__version__  =', autolens.__version__); print('autogalaxy.__file__   =', autogalaxy.__file__); print('autofit.__file__      =', autofit.__file__); print('jax.__version__       =', jax.__version__); print('jax devices           =', jax.devices())"

echo "=========================================="
echo "LEG A: point-source image-plane breakdown (galaxy scale, solved + plain control)"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/point_source/likelihood_breakdown/image_plane.py --config-name hpc_ral_cpu_fp64

echo "=========================================="
echo "LEG B: cluster image-plane breakdown (per-source solves + fused plain/solved)"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/cluster/likelihood_breakdown/image_plane.py --config-name hpc_ral_cpu_fp64

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
echo "Finished."
date
