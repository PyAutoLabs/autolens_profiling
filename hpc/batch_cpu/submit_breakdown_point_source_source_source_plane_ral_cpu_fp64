#!/bin/bash -l
#
# 2026-09 source-plane point-source campaign, phase 2a (autolens_profiling#322):
# RAL CPU rows for the phase-1 breakdown cell + the pytree-input A/B.
# Single-source only (the `simple` dataset); nothing under scripts/cluster/.
#
# WHAT THIS MEASURES. Two cells, two processes, on ONE pinned, quiet RAL CPU node:
#
#   1. scripts/point_source_source/likelihood_breakdown/source_plane.py
#      The phase-1 instrument: fused FitPositionsSourceSolved (solved lane) and
#      FitPositionsSource (plain lane) likelihoods, cumulative-prefix rows, CSE
#      probes, dispatch floors, value_and_grad cost; asserts eager-vs-JIT (rtol
#      1e-4), vmap (rtol 1e-10), the regression literals (rtol 1e-8) and a finite,
#      NON-zero gradient.
#   2. scripts/point_source_source/likelihood_breakdown/pytree_input_ab.py
#      Interleaved A/B of how the parameters enter the likelihood: pytree
#      (production ModelInstance argument) vs flat_vector (instance_from_vector
#      inside the trace) vs flat_leaves (tree_unflatten inside the trace), rows
#      forward / value_and_grad / floor per lane, 20 rounds x 20 calls, route
#      order rotated each round. Asserts route agreement on log L at rtol 1e-10
#      and finite, non-zero gradients for every route. The phase-2b go/no-go
#      (pytree - flat_vector >= 0.05 ms AND >= 15 % of the fused call) is decided
#      on THIS row.
#
# HOST PINNING. euclid-ral-compute-10-2 (Xeon 8490H; the image-plane campaign's
# phase-1/3 host): on 2026-09-26 `sinfo -p ral -N -o "%N %t %C"` showed it idle and
# responding (no trailing *), and `squeue -u jnightin` showed no jnightin job on it.
# Check before submitting; if 10-2 is busy or hosts another jnightin job, pin
# another responding 10-* node (not 10-1 / 10-5, which carry jnightin arrays that
# day), or fall back to --partition=gpu CPUs-only (no --gres), and say so in the note.
#
# LIBRARY. The shared /mnt/ral/jnightin/PyAuto stack is used AS-IS (no feature
# branch prepend): PyAutoFit dd9fbe0a / PyAutoArray 3de624b5 / PyAutoGalaxy
# 70a61e26 / PyAutoLens 86054bbc on 2026-09-26. Against the local mains (Fit
# cf83504e / Array 14d63360 / Galaxy 0e4b89cf / Lens 4487eb47) the diff is the
# 2026.9.26.1 release-tag bumps plus interferometer/inversion (PyAutoArray#575,
# #578) and MultiStart (PyAutoFit#1647) changes: `git diff --name-only` touches
# nothing on the source-plane point-source paths (autolens/point/,
# AnalysisPoint, autofit/jax/pytrees.py, mapper/model.py), so the RAL stack is
# release-equivalent for these cells. The job echoes the HEADs and the JSONs
# record source_revisions.
#
# THREADS. OMP/MKL/OPENBLAS pinned to 1 (BLAS family only); the JAX CPU pool
# sizes from the 8 CPUs of --cpus-per-task=8. The JSONs record thread_environment,
# sched_affinity, os_cpu_count, loadavg start/end and (A/B) the process thread
# count after the first compile.
#
# Writes results/breakdown/point_source_source/source_plane_hpc_ral_cpu_fp64.{json,png}
# and pytree_input_ab_hpc_ral_cpu_fp64.{json,png}. Pull with `hpc/sync pull`;
# copy output/output.<id>.out by hand to
# results/notes/point_source_source_plane_2026_09_26_ral_job_<id>.out
# (known gap: `hpc/sync pull` does not fetch batch_cpu logs).
#
# Known gap (not fixed here): scripts/misc/wall/check_submits.py's _PYTHON_CALL
# regex does not match `python3 -u`, so it cannot see which cells this submit runs.
#
# WALL-BASIS:
#   Measured on RAL job 356368 (2026-09-26, euclid-ral-compute-10-2, Xeon 8490H): source_plane.py
#   34 s and pytree_input_ab.py at 20 x 20 24 s process wall (job 1:10 total).
#   Laptop witnesses (WSL2, load ~5): 71 s / 64 s. x 2.0 headroom each, well inside 2 h.
#   cell: point_source_source/source_plane/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 34  ref: ral-job-356368-source_plane_hpc_ral_cpu_fp64  headroom: 2.0
#   cell: point_source_source/pytree_input_ab/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 24  ref: ral-job-356368-pytree_input_ab_hpc_ral_cpu_fp64  headroom: 2.0

#SBATCH -J source_plane_p2a
#SBATCH --partition=ral
#SBATCH --nodelist=euclid-ral-compute-10-2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=2:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Repo root from where this was submitted (hpc/batch_cpu/../..), so it runs from
# a worktree of the feature branch. sbatch from inside hpc/batch_cpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent JAX compile cache: compile times are recorded and must be cold.
unset JAX_COMPILATION_CACHE_DIR

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "nodelist:       ${SLURM_JOB_NODELIST:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "sched_affinity: $(python3 -c 'import os; print(len(os.sched_getaffinity(0)))')"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cells:          point_source_source/likelihood_breakdown/{source_plane,pytree_input_ab}"
echo "Precision:      fp64 (JAX_ENABLE_X64=$JAX_ENABLE_X64)"
echo "Thread env:     OMP=$OMP_NUM_THREADS MKL=$MKL_NUM_THREADS OPENBLAS=$OPENBLAS_NUM_THREADS NPROC=$NPROC"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r (shared)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance (refuses unless the libraries come from the shared stack) ==="
python3 -c "
import os, autoarray, autolens, autofit, autogalaxy, jax
for m in (autoarray, autolens, autofit, autogalaxy):
    print(f'{m.__name__}.__file__ =', m.__file__)
    assert os.path.realpath(m.__file__).startswith('/mnt/ral/jnightin/PyAuto/'), f'{m.__name__} not from the shared stack'
print('jax', jax.__version__, jax.devices(), jax.default_backend())
assert jax.default_backend() == 'cpu', 'JAX is not on the CPU'
print('ASSERT OK: CPU backend, libraries from /mnt/ral/jnightin/PyAuto')
" || exit 3

echo "=========================================="
echo "run 1/2: source_plane breakdown"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/point_source_source/likelihood_breakdown/source_plane.py --config-name hpc_ral_cpu_fp64

echo "=========================================="
echo "run 2/2: pytree-input A/B (20 x 20)"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/point_source_source/likelihood_breakdown/pytree_input_ab.py --config-name hpc_ral_cpu_fp64 --rounds 20 --calls 20

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
echo "Finished."
date
