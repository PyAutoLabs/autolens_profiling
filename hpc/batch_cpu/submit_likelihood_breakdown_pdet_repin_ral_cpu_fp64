#!/bin/bash -l
#
# autolens_profiling#525: re-pin the likelihood-breakdown cells after PyAutoArray#682
# (pseudo-determinant ln det H, +9.21 nats per regularized mapper). CPU fp64, one array
# task per (cell, variant).
#
# WHAT THIS MEASURES. Each task runs one cell eagerly at its pinned configuration (HST,
# --over-sampling flat1, fiducial mesh) and logs:
#   - "figure_of_merit (log_evidence) = ..." -> the library's evidence, i.e. the new pin;
#   - "log_evidence (inv matrices)" vs "log_evidence (reference)" -> the cell's own
#     grounded evidence against the library's (the #525 fix);
#   - the cell's own regression line (PASSED/SKIPPED or the AssertionError naming "got").
# The old pins are expected to fail on today's library; the assertion message carries
# the measured value. matrix_free logs "exact log dets" (log_det_regularization re-pin).
#
#   0 delaunay constant_split      5 rectangular --rect-mesh rtu
#   1 delaunay adapt_split         6 matrix_free --mesh rectangular
#   2 delaunay_nn constant_split   7 matrix_free --mesh delaunay
#   3 delaunay_nn adapt_split      8 matrix_free --mesh delaunay_nn
#   4 rectangular --rect-mesh bilinear   9 datacube/delaunay --instrument sma (validation, no pin)
#
# LIBRARY CODE. A PRIVATE checkout of the five library mains at the SHAs below
# ($PYAUTO_PRIVATE_BASE), which include PyAutoArray#682. The job refuses to run if a
# library imports from elsewhere. The shared /mnt/ral/jnightin/PyAuto mirror is never used.
#   PyAutoArray af80e69d  PyAutoFit bdb7af0e  PyAutoGalaxy bc3918a4
#   PyAutoLens bb87dad3   PyAutoNerves 9b204c90
#
# NODE. `ral` only, exclusive per task, throttled to 5.
#
# WALL-BASIS:
#   No recent CPU breakdown row in the repo to size from; the cells are eager plus
#   jitted step rows on one HST dataset. 4 h per task is a generous cap.

#SBATCH -J lb_pdet_repin
#SBATCH --partition=ral
#SBATCH --exclusive
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64gb
#SBATCH --time=4:00:00
#SBATCH --array=0-9%5
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err

# Submit from hpc/batch_cpu/ (the -o/-e paths are relative).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PYAUTO_PRIVATE_BASE="${PYAUTO_PRIVATE_BASE:-/mnt/ral/jnightin/PyAuto_wt/likelihood-breakdown-cells-pdet}"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh
export PYTHONPATH=$PYAUTO_PRIVATE_BASE/PyAutoNerves:$PYAUTO_PRIVATE_BASE/PyAutoFit:$PYAUTO_PRIVATE_BASE/PyAutoArray:$PYAUTO_PRIVATE_BASE/PyAutoGalaxy:$PYAUTO_PRIVATE_BASE/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMBA_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export MPLBACKEND=Agg
export MPLCONFIGDIR=$AP_ROOT/output/mpl_${SLURM_JOB_ID:-local}
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
unset JAX_COMPILATION_CACHE_DIR PYAUTO_SMALL_DATASETS PYAUTO_FAST_PLOTS

cd $AP_ROOT
python3 - <<'EOF'
import os, autoarray, autofit, autogalaxy, autolens, autonerves
base = os.path.realpath(os.environ["PYAUTO_PRIVATE_BASE"])
for m in (autoarray, autofit, autogalaxy, autolens, autonerves):
    path = os.path.realpath(m.__file__)
    if not path.startswith(base + os.sep):
        raise SystemExit(f"REFUSING: {m.__name__} imports from {path}, not {base}")
    print(m.__name__, path)
from autoarray.inversion.inversion.abstract import AbstractInversion
assert hasattr(AbstractInversion, "_intrinsic_regularization_blocks"), "library predates #682"
EOF

CONFIG=ral_cpu_fp64_pdet_repin
case ${SLURM_ARRAY_TASK_ID} in
    0) CMD="scripts/imaging/delaunay/likelihood_breakdown.py --regularization constant_split" ;;
    1) CMD="scripts/imaging/delaunay/likelihood_breakdown.py --regularization adapt_split" ;;
    2) CMD="scripts/imaging/delaunay_nn/likelihood_breakdown.py --regularization constant_split" ;;
    3) CMD="scripts/imaging/delaunay_nn/likelihood_breakdown.py --regularization adapt_split" ;;
    4) CMD="scripts/imaging/rectangular/likelihood_breakdown.py --rect-mesh bilinear" ;;
    5) CMD="scripts/imaging/rectangular/likelihood_breakdown.py --rect-mesh rtu" ;;
    6) CMD="scripts/imaging/pixelized/matrix_free.py --mesh rectangular" ;;
    7) CMD="scripts/imaging/pixelized/matrix_free.py --mesh delaunay" ;;
    8) CMD="scripts/imaging/pixelized/matrix_free.py --mesh delaunay_nn" ;;
    9) CMD="scripts/datacube/delaunay/likelihood_breakdown.py --instrument sma" ;;
    *) echo "no task ${SLURM_ARRAY_TASK_ID}"; exit 1 ;;
esac

echo "TASK ${SLURM_ARRAY_TASK_ID}: python3 -u $CMD --config-name $CONFIG"
# The old pins are expected to fail; keep going so the measured value is logged.
# (`|| rc=$?` so activate.sh's ERR trap does not abort the task on that failure.)
rc=0
python3 -u $CMD --config-name $CONFIG || rc=$?
echo "EXIT $rc"
echo "Finished."
date
