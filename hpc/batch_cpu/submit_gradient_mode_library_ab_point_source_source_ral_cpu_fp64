#!/bin/bash -l
#
# 2026-09 source-plane point-source campaign, phase 2e (autolens_profiling#334):
# REFERENCE CPU row for gradient_mode through the library -- the real
# af.MultiStartAdam batched step in forward (AnalysisPoint's declared default)
# vs reverse (gradient_mode="reverse" override). Single-source only (the
# `simple` dataset); nothing under scripts/cluster/.
#
# WHAT THIS MEASURES. One cell, one process:
#
#   scripts/point_source_source/likelihood_breakdown/gradient_mode_library_ab.py
#      Rungs L5 / L24 (phase 2c's ladder) x solved / plain lanes. Per rung x
#      lane, search.fit is run until MultiStartGradient._fit jits its
#      _value_and_grad_finite objective (jax.jit wrapped by a recorder, fit
#      aborted before any compile), once per mode; that captured _vmapped is
#      gated (forward == reverse over PRNGKey 0..15 start batches of B=8:
#      objective rtol 1e-10, gradient rtol 1e-8, finite, grad_finite flag,
#      non-zero, StableHLO distinct) and timed: lower + compile, then 20 rounds
#      x 20 calls of the AOT executable and the jitted callable, both modes
#      interleaved. Then one short end-to-end MultiStartAdam fit per lane per
#      mode at L5 (n_starts 8, n_steps 20, fixed seed): same best vector / max
#      log L, wall per mode.
#
# HOST. The quiet RAL gpu-partition host CPUs (AMD EPYC 7702) with NO --gres,
# pinned to euclid-ral-gpu-2 -- phase 2c's reference CPU host (job 358770).
# Config label hpc_ral_gpunode_cpu_fp64.
#
# LIBRARY. The shared /mnt/ral/jnightin/PyAuto stack does NOT yet carry the
# merged gradient_mode commits (2026-09-27: PyAutoFit c156a9d8, PyAutoLens
# dcbd4b71) and is left untouched (live DR1 array jobs use it). PyAutoFit and
# PyAutoLens come from scratch clones checked out at the merge commits,
# prepended to PYTHONPATH:
#   /mnt/ral/jnightin/p2d_check/PyAutoFit  867af1c6 (PyAutoFit#1649 merge)
#   /mnt/ral/jnightin/p2d_check/PyAutoLens b3c9b68e (PyAutoLens#752 merge)
# PyAutoNerves / PyAutoArray / PyAutoGalaxy stay on the shared stack (Nerves
# bf10410 and Array e281abf3 equal the local mains; Galaxy ba8a08fa is one PR
# behind main 152695e0, which touches only PowerLawCore, unused here). The
# job refuses to run unless autofit/autolens import from the scratch clones at
# those exact HEADs; the JSON records source_revisions from the imported files.
#
# THREADS. OMP/MKL/OPENBLAS pinned to 1 (BLAS family only); the JAX CPU pool
# sizes from the 8 CPUs of --cpus-per-task=8.
#
# Writes results/breakdown/point_source_source/gradient_mode_library_ab_hpc_ral_gpunode_cpu_fp64.{json,png}.
# `hpc/sync pull` does not fetch batch_cpu logs: scp output/output.<id>.out to
# results/notes/point_source_source_plane_2026_09_27_ral_job_<id>.out.
#
# WALL-BASIS:
#   Laptop witness (WSL2, 8 threads): gradient_mode_library_ab.py at 20 x 20, 4 rung x lane
#   cells + 5 end-to-end fits, 315 s process wall (compile-dominated: the L24
#   solved reverse compile is ~114 s on the laptop, ~80 s on this host in phase 2c).
#   cell: point_source_source/gradient_mode_library_ab/simple  device: cpu  precision: fp64
#   source: measured-wall  wall: 315  ref: laptop-gradient_mode_library_ab_local_cpu_fp64  headroom: 3.0

#SBATCH -J gradmode_p2e
#SBATCH --partition=gpu
#SBATCH --nodelist=euclid-ral-gpu-2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=1:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Repo root from where this was submitted (hpc/batch_cpu/../..), so it runs from
# a worktree of the feature branch. sbatch from inside hpc/batch_cpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

# The merged gradient_mode commits, from scratch clones (see LIBRARY above).
SCRATCH=/mnt/ral/jnightin/p2d_check
EXPECT_FIT=867af1c6b917b326c732f092b0ea9858447f2a78
EXPECT_LENS=b3c9b68e7ff5b0c2d5d4a42fcc8139ca777a66ce
export PYTHONPATH=$SCRATCH/PyAutoFit:$SCRATCH/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export PYAUTO_SKIP_WORKSPACE_VERSION_CHECK=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent JAX compile cache: compile times are recorded and must be cold.
unset JAX_COMPILATION_CACHE_DIR
AB_CONFIG_NAME=${AB_CONFIG_NAME:-hpc_ral_gpunode_cpu_fp64}

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "nodelist:       ${SLURM_JOB_NODELIST:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "sched_affinity: $(python3 -c 'import os; print(len(os.sched_getaffinity(0)))')"
echo "loadavg:        $(cat /proc/loadavg)"
echo "config name:    $AB_CONFIG_NAME"
echo "Cell:           point_source_source/likelihood_breakdown/gradient_mode_library_ab"
echo "Precision:      fp64 (JAX_ENABLE_X64=$JAX_ENABLE_X64)"
echo "Thread env:     OMP=$OMP_NUM_THREADS MKL=$MKL_NUM_THREADS OPENBLAS=$OPENBLAS_NUM_THREADS NPROC=$NPROC"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoArray PyAutoGalaxy; do
    printf '%-22s %s\n' "$r (shared)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
for r in PyAutoFit PyAutoLens; do
    printf '%-22s %s\n' "$r (scratch clone)" "$(git -C $SCRATCH/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance (refuses unless autofit/autolens are the merge-commit scratch clones) ==="
python3 -c "
import os, subprocess, autoarray, autolens, autofit, autogalaxy, jax
for m in (autoarray, autolens, autofit, autogalaxy):
    print(f'{m.__name__}.__file__ =', m.__file__)
scratch = '$SCRATCH/'
for m, repo, want in ((autofit, 'PyAutoFit', '$EXPECT_FIT'), (autolens, 'PyAutoLens', '$EXPECT_LENS')):
    assert os.path.realpath(m.__file__).startswith(scratch + repo + '/'), f'{m.__name__} not from the scratch clone'
    head = subprocess.check_output(['git', '-C', scratch + repo, 'rev-parse', 'HEAD'], text=True).strip()
    assert head == want, f'{repo} scratch clone at {head}, want {want}'
for m in (autoarray, autogalaxy):
    assert os.path.realpath(m.__file__).startswith('/mnt/ral/jnightin/PyAuto/'), f'{m.__name__} not from the shared stack'
print('AnalysisPoint.gradient_mode =', autolens.AnalysisPoint.gradient_mode)
assert autolens.AnalysisPoint.gradient_mode == 'forward'
print('jax', jax.__version__, jax.devices(), jax.default_backend())
assert jax.default_backend() == 'cpu', 'JAX is not on the CPU'
print('ASSERT OK: CPU backend, gradient_mode merge commits from the scratch clones')
" || exit 3

echo "=========================================="
echo "gradient_mode library A/B (20 x 20)"
date
echo "loadavg: $(cat /proc/loadavg)"
python3 -u scripts/point_source_source/likelihood_breakdown/gradient_mode_library_ab.py --config-name $AB_CONFIG_NAME --rounds 20 --calls 20

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
echo "Finished."
date
