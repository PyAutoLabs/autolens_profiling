#!/bin/bash -l
#
# A100 likelihood-breakdown profile: interferometer/delaunay x {sma, alma, alma_high} x mask radius
# {2.0, 5.0} x fp64, sparse (W~) path — a SLURM array of 6 independent tasks.
# autolens_profiling#348 (interferometer likelihood campaign 3/3, phase 3): the Hilbert-1500 Delaunay + AdaptSplit(0.1, 10, 0.1)
# cell on InversionInterferometerSparse at the two off-preset mask radii the phase-4 decision
# matrix needs beside the CPU rows (every committed A100 row is at the preset r3.5). Harness:
# scripts/misc/likelihood_breakdown/interferometer_pixelized.py (--mask-radius; a non-preset
# radius appends _r<radius> to the output names via mask_radius_suffix).
#
# Array task id -> (instrument, radius):
#   0 sma r2.0   1 sma r5.0   2 alma r2.0   3 alma r5.0   4 alma_high r2.0   5 alma_high r5.0
# Flags follow the committed hpc_a100_fp64 submits (sma --dense-library, alma
# --dense-max-vis 2000000, alma_high neither) with the lever sub-rows (--solver-ab,
# --fp32-fft-arm, --batch-size-sweep) OFF: not needed for the matrix and they multiply wall time.
# alma_high r5.0's FFT extent is ~(5/3.5)^2 x the r3.5 one: an OOM inside the cell is recorded
# in the JSON as a result (the ledger marks it blocked), not a job failure.
#
# Libraries: the SHARED mirror /mnt/ral/jnightin/PyAuto (refreshed by HPCPullPyAuto to the
# library mains), via activate.sh. JAX_ENABLE_X64 is exported explicitly (sbatch does not
# inherit it); the cell refuses to run with x64 off.
#
# Output (config-tagged runs: interferometer/ for alma, interferometer/<instrument>/ otherwise):
#   results/breakdown/interferometer/sma/delaunay_hpc_a100_fp64_r{2.0,5.0}.{json,png}
#   results/breakdown/interferometer/delaunay_hpc_a100_fp64_r{2.0,5.0}.{json,png}
#   results/breakdown/interferometer/alma_high/delaunay_hpc_a100_fp64_r{2.0,5.0}.{json,png}
#
# Submit from hpc/batch_gpu/ (the -o/-e paths are relative).

#SBATCH -J bd_intf_del_rsweep
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=3:00:00
#SBATCH --array=0-5
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

INSTRUMENTS=(sma sma alma alma alma_high alma_high)
RADII=(2.0 5.0 2.0 5.0 2.0 5.0)
TASK_ID=${SLURM_ARRAY_TASK_ID:?run as a SLURM array (sbatch --array=0-5)}
INSTRUMENT=${INSTRUMENTS[$TASK_ID]}
RADIUS=${RADII[$TASK_ID]}
case "$INSTRUMENT" in
    sma)  EXTRA_FLAGS="--dense-library" ;;
    alma) EXTRA_FLAGS="--dense-max-vis 2000000" ;;
    *)    EXTRA_FLAGS="" ;;
esac

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..): it runs from
# a RAL worktree of the feature branch, not only the canonical RAL checkout.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PROJECT_PATH="$AP_ROOT"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"

nvidia-smi

cd $AP_ROOT

echo "=== source revisions (shared mirror) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C $PYAUTO_HPC_BASE/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
python3 -c "
import importlib.metadata as m, autoarray, autolens, jax
print('autoarray.__file__ =', autoarray.__file__)
print('autolens.__file__ =', autolens.__file__)
print('nufftax', m.version('nufftax'), 'jax', jax.__version__, 'x64', jax.config.x64_enabled)
assert tuple(int(x) for x in m.version('nufftax').split('.')[:2]) >= (0, 6), 'nufftax below the 0.6.1 floor'
"

echo "=========================================="
date
echo "Cell:           likelihood_breakdown/interferometer/delaunay"
echo "Array task:     ${SLURM_ARRAY_JOB_ID}_${TASK_ID}"
echo "Instrument:     $INSTRUMENT"
echo "Mask radius:    $RADIUS"
echo "Precision:      fp64"
python3 -u scripts/interferometer/likelihood_breakdown/delaunay.py \
    --instrument $INSTRUMENT \
    --mask-radius $RADIUS \
    --config-name hpc_a100_fp64 \
    --vmap-batch 16,4 \
    $EXTRA_FLAGS

echo "Finished."
date
