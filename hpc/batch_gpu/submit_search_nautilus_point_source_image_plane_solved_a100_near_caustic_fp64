#!/bin/bash -l
#
# PyAutoLens#678 phase B — point-source defaults evidence campaign: A100
# search profiling for searches/nautilus/point_source/image_plane_solved x
# near_caustic x fp64.
#
# Feeds exp5 (near-caustic): solved-centre image-plane fit near the
# tangential caustic (source_centre_caustic_fraction: 0.95).

# WALL-BASIS: — one row per cell this submit runs. See scripts/misc/wall/README.md.
#   `rates` cites a step rate measured on THAT cell (wall/rates.py); an MGE rate
#   can never stand in for a pixelized cell — that is what killed RAL job 340576.
#   cell: point_source/image_plane_solved/near_caustic  device: a100  precision: fp64
#   source: unmeasured  probe-first: yes
#   NOTE: no step rate has been measured on this cell. Run one short arm
#   before trusting --time; a truncated arm still measures s/step.

#SBATCH -J search_nautilus_point_source_image_plane_solved_near_caustic_fp64
#SBATCH --partition=gpu
# Node exclusion (2026-08-28): euclid-ral-gpu-1 carries a MIG-mode A100 with
# no instances that SLURM still hands out as a plain gpu:A100 — see
# _gpu_preflight.sh, which stays armed as the backstop.
#SBATCH --exclude=euclid-ral-gpu-1
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=2:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autolens_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi

echo "=========================================="
date
echo "Cell:       searches/nautilus/point_source/image_plane_solved"
echo "Instrument: near_caustic"
echo "Precision:  fp64"

cd $AP_ROOT
python3 scripts/point_source/searches/nautilus/image_plane_solved.py \
    --instrument near_caustic \
    --config-name hpc_a100_fp64 \
    --output-dir $AP_ROOT/results/searches/nautilus/point_source/image_plane_solved/near_caustic

echo "Finished."
date
