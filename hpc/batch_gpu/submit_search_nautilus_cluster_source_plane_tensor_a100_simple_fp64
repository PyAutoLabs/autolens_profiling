#!/bin/bash -l
#
# PyAutoLens#678 phase B — point-source defaults evidence campaign: A100
# search profiling for searches/nautilus/cluster/source_plane_tensor x simple x fp64.
#
# Cluster tier — feeds the cluster analogue of exp1 (source-plane
# flavours): free-centre jacobian-weighted FitPositionsSourceTensor
# factor-graph fit.

#SBATCH -J search_nautilus_cluster_source_plane_tensor_simple_fp64
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=4:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autolens_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi

echo "=========================================="
date
echo "Cell:       searches/nautilus/cluster/source_plane_tensor"
echo "Instrument: simple"
echo "Precision:  fp64"

cd $AP_ROOT
python3 scripts/cluster/searches/nautilus/source_plane_tensor.py \
    --instrument simple \
    --config-name hpc_a100_fp64 \
    --output-dir $AP_ROOT/results/searches/nautilus/cluster/source_plane_tensor/simple

echo "Finished."
date
