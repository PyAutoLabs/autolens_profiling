#!/bin/bash -l
#
# A100 likelihood-runtime profile: imaging/delaunay x hst x fp64 — PyAutoArray#531
# A/B leg: **control**. Single-JIT whole-likelihood cost, the end-to-end companion
# to submit_breakdown_imaging_delaunay_a100_hst_fp64_control.
#
# Same private-checkout PYTHONPATH override as the breakdown A/B legs; the
# shared /mnt/ral/jnightin/PyAuto install is untouched. Phase A (--vmap-probe)
# is skipped: only the full single-JIT + vmap timing is wanted here.

#SBATCH -J rt_delaunay_control
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=3:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err

export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

AA_ROOT=/mnt/ral/jnightin/PyAuto_wt/delaunay-walk-early-exit/PyAutoArray_control
export PYTHONPATH=$AA_ROOT:$PYTHONPATH

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi
echo "=========================================="
date
echo "Cell:           likelihood_runtime/imaging/delaunay"
echo "A/B leg:        control"
printf 'PyAutoArray(AB) %s\n' "$(git -C $AA_ROOT rev-parse HEAD 2>&1)"

cd $AP_ROOT
python3 -c "import autoarray; print('autoarray.__file__ =', autoarray.__file__)"

python3 -u scripts/imaging/likelihood_runtime/delaunay.py \
    --instrument hst \
    --config-name hpc_a100_fp64_control_2026_09_07

echo "Finished."
date
