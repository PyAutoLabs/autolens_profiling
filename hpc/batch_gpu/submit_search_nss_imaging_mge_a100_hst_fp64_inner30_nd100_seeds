#!/bin/bash -l
#
# Inference programme Phase 2 (issue #149) — mainline af.NSS A100 scan,
# RELIABILITY arm: searches/nss/imaging/mge x hst x fp64,
# inner steps = 30, n_live = 200, num_delete = 100, SEEDS 43-46.
#
# ARM: n_live 200, num_mcmc_steps 30, num_delete 100, dlogz -3, unchunked —
#      i.e. byte-identical to the wave-2 (a2) inner30_nd100 arm except for the
#      RNG seed. Seed 42 is already recorded (sampler wall ~3528 s); these four
#      array tasks add seeds 43, 44, 45, 46.
#
# QUESTION: every Phase 2 row so far is a SINGLE seed, so none of the
#      wave-1/wave-2 logZ and wall differences has an error bar. Nested
#      sampling's logZ carries a stochastic error of order sqrt(dlogX/n_live)
#      and the wall varies with how many replacements the run needs; without a
#      seed spread we cannot say whether e.g. the inner30 logZ 31691.20 vs the
#      Nautilus reference 31690.5 is a real offset or seed noise, nor whether
#      the num_delete wall win is bigger than run-to-run scatter. Four extra
#      seeds at the operating point turn the single number into a 5-point
#      distribution (mean +/- spread) for both logZ and wall — the bar every
#      later Phase 2 comparison gets measured against.
#
# ARTIFACT ISOLATION — THE CRITICAL PART OF THIS SCRIPT
#      --config-name MUST carry the seed. It sets BOTH the results basename
#      (_profile_cli.resolve_output_paths) AND the af.NSS search ``name``
#      (searches/_samplers.build_nss). With a shared config name all four array
#      tasks would write the same
#      results/.../hpc_hpc_a100_fp64_inner30_nd100.json and the last task to
#      finish would be the only survivor — three GPU-hours silently lost.
#      Hence --config-name hpc_a100_fp64_inner30_nd100_seed${SEED}, built from
#      the shell variable below.
#      VERIFIED, second layer: ``seed`` IS an entry in
#      ``af.NSS.__identifier_fields__`` — introspected on this branch as
#      ('n_live', 'num_mcmc_steps', 'num_delete', 'termination', 'seed') — so
#      the autofit identifier differs per seed as well, and the output/
#      directories cannot collide even if the config name were ever
#      harmonised. Both layers are deliberate: the config name keeps the
#      RESULTS json disjoint, the identifier field keeps the SEARCH state
#      disjoint.
#
# WALL-TIME ESTIMATE: the recorded seed-42 row for this exact arm ran ~3528 s
#      sampler wall (~1.24M evals at ~2.83 ms/eval) + ~45 s viz + compile.
#      Seed only changes WHICH points are drawn, not the scaling model, so the
#      expected wall per task is the same ~3600 s (~1 h). Nested sampling's
#      iteration count does vary with the seed, so --time is set to 2:30:00
#      (~2.5x the measured baseline) — enough headroom for an unlucky run
#      without over-reserving four GPU slots in the overnight queue.
#
# VRAM: peak inner-step memory scales with num_delete, not n_live (af.NSS
#      chunk_size docstring). From 937 MiB at num_delete=50 -> ~18.7
#      MiB/particle -> ~1.83 GiB here. Comfortable on an 80 GB A100;
#      chunk_size stays unset (it is also the one NSS knob absent from
#      __identifier_fields__, so it must never be used to distinguish arms).

# WALL-BASIS: — one row per cell this submit runs. See scripts/misc/wall/README.md.
#   `rates` cites a step rate measured on THAT cell (wall/rates.py); an MGE rate
#   can never stand in for a pixelized cell — that is what killed RAL job 340576.
#   cell: imaging/mge/hst  device: a100  precision: fp64
#   source: unmeasured  probe-first: yes
#   NOTE: no step rate has been measured on this cell. Run one short arm
#   before trusting --time; a truncated arm still measures s/step.

#SBATCH -J search_nss_imaging_mge_hst_fp64_inner30_nd100_seeds
#SBATCH --partition=gpu
# Node exclusion (2026-08-28): euclid-ral-gpu-1 carries a MIG-mode A100 with
# no instances that SLURM still hands out as a plain gpu:A100 — see
# _gpu_preflight.sh, which stays armed as the backstop.
#SBATCH --exclude=euclid-ral-gpu-1
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=2:30:00
#SBATCH --array=0-3
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autolens_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

# Seeds 43-46; seed 42 is the already-recorded row for this arm.
SEED=$((43 + SLURM_ARRAY_TASK_ID))

# Phase 2 scan knobs. Every value is stated explicitly (including the ones that
# match the builder defaults in searches/_samplers.py) so the arm is readable
# from this file alone and cannot drift if a default changes.
export SEARCHES_NSS_N_LIVE=200
export SEARCHES_NSS_NUM_MCMC_STEPS=30
export SEARCHES_NSS_NUM_DELETE=100
export SEARCHES_NSS_TERMINATION=-3.0
export SEARCHES_NSS_SEED=$SEED

nvidia-smi

echo "=========================================="
date
echo "Cell:       searches/nss/imaging/mge"
echo "Instrument: hst"
echo "Precision:  fp64"
echo "Arm:        inner30_nd100 seed=$SEED (n_live=200, num_delete=100), reliability"

cd $AP_ROOT
python3 scripts/imaging/searches/nss/mge.py \
    --instrument hst \
    --config-name hpc_a100_fp64_inner30_nd100_seed${SEED} \
    --output-dir $AP_ROOT/results/searches/nss/imaging/mge/hst

echo "Finished."
date
