#!/bin/bash -l
#
# 2026-09 source-plane point-source campaign, phase 2e (autolens_profiling#334):
# the A100 row for gradient_mode through the library -- the real
# af.MultiStartAdam batched step in forward (AnalysisPoint's declared default)
# vs reverse (gradient_mode="reverse" override). Single-source only.
#
# WHAT THIS MEASURES. The same cell as the RAL CPU submit
# (hpc/batch_cpu/submit_gradient_mode_library_ab_point_source_source_ral_cpu_fp64),
# one process, on ONE RAL A100:
#
#   scripts/point_source_source/likelihood_breakdown/gradient_mode_library_ab.py
#      (L5 / L24 x solved / plain; the search's own captured _vmapped per mode,
#      gated then timed 20 x 20 interleaved; end-to-end L5 fits per mode).
#      On a GPU the end-to-end fits' _fit wall also includes the search's
#      batched-memory probe (two throwaway compiles), in both modes alike.
#
# CONFIG LABEL. --config-name hpc_a100_fp64. Pinned to euclid-ral-gpu-1 so the
# reference CPU job (euclid-ral-gpu-2, no --gres) has its node to itself.
#
# LIBRARY. PyAutoFit / PyAutoLens from the scratch clones at the merge commits
# (/mnt/ral/jnightin/p2d_check/{PyAutoFit 867af1c6, PyAutoLens b3c9b68e}),
# prepended to PYTHONPATH; the rest from the untouched shared stack -- see the
# CPU submit's LIBRARY block. The job asserts the imported files and HEADs.
#
# BACKEND. JAX_PLATFORMS=cuda (NOT "cuda,cpu") and JAX_PLATFORM_NAME=cuda; the
# job asserts jax.default_backend()=="gpu". XLA_FLAGS byte-identical to the CPU
# submit's.
#
# Writes results/breakdown/point_source_source/gradient_mode_library_ab_hpc_a100_fp64.{json,png}.
#
# WALL-BASIS:
#   Laptop witness (WSL2, 8 threads): gradient_mode_library_ab.py at 20 x 20, 4 rung x lane
#   cells + 5 end-to-end fits, 315 s process wall. Phase 2c's A100 compiles were
#   ~0.3x the laptop's at L24 reverse but ~1-2x at L5, and the GPU fits add the memory
#   probe's compiles, hence the same wide headroom as the CPU row.
#   cell: point_source_source/gradient_mode_library_ab/simple  device: gpu  precision: fp64
#   source: measured-wall  wall: 315  ref: laptop-gradient_mode_library_ab_local_cpu_fp64  headroom: 3.0

#SBATCH -J gradmode_p2e_gpu
#SBATCH --partition=gpu
#SBATCH --nodelist=euclid-ral-gpu-1
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=1:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Repo root from where this was submitted (hpc/batch_gpu/../..). sbatch from
# inside hpc/batch_gpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

SCRATCH=/mnt/ral/jnightin/p2d_check
EXPECT_FIT=867af1c6b917b326c732f092b0ea9858447f2a78
EXPECT_LENS=b3c9b68e7ff5b0c2d5d4a42fcc8139ca777a66ce
export PYTHONPATH=$SCRATCH/PyAutoFit:$SCRATCH/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=1
export PYAUTO_SKIP_WORKSPACE_VERSION_CHECK=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent compile cache: compile times are recorded and must be cold.
unset JAX_COMPILATION_CACHE_DIR

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
nvidia-smi --query-gpu=name,driver_version,memory.total,utilization.gpu --format=csv || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "gpus:           ${CUDA_VISIBLE_DEVICES:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cell:           point_source_source/likelihood_breakdown/gradient_mode_library_ab"
echo "Backend:        JAX_PLATFORMS=$JAX_PLATFORMS JAX_PLATFORM_NAME=$JAX_PLATFORM_NAME"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoArray PyAutoGalaxy; do
    printf '%-22s %s\n' "$r (shared)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
for r in PyAutoFit PyAutoLens; do
    printf '%-22s %s\n' "$r (scratch clone)" "$(git -C $SCRATCH/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance + backend assertion ==="
python3 -c "
import os, subprocess, autoarray, autolens, autofit, autogalaxy, jax
for m in (autoarray, autolens, autofit, autogalaxy):
    print(f'{m.__name__}.__file__ =', m.__file__)
scratch = '$SCRATCH/'
for m, repo, want in ((autofit, 'PyAutoFit', '$EXPECT_FIT'), (autolens, 'PyAutoLens', '$EXPECT_LENS')):
    assert os.path.realpath(m.__file__).startswith(scratch + repo + '/'), f'{m.__name__} not from the scratch clone'
    head = subprocess.check_output(['git', '-C', scratch + repo, 'rev-parse', 'HEAD'], text=True).strip()
    assert head == want, f'{repo} scratch clone at {head}, want {want}'
for m in (autoarray, autogalaxy):
    assert os.path.realpath(m.__file__).startswith('/mnt/ral/jnightin/PyAuto/'), f'{m.__name__} not from the shared stack'
assert autolens.AnalysisPoint.gradient_mode == 'forward'
print('jax', jax.__version__, jax.devices(), jax.default_backend())
assert jax.default_backend() == 'gpu', 'JAX is not on the GPU'
print('ASSERT OK: GPU backend, gradient_mode merge commits from the scratch clones')
" || exit 3

echo "=========================================="
echo "gradient_mode library A/B on A100 (20 x 20)"
date
python3 -u scripts/point_source_source/likelihood_breakdown/gradient_mode_library_ab.py --config-name hpc_a100_fp64 --rounds 20 --calls 20

echo "=========================================="
nvidia-smi --query-gpu=name,memory.used --format=csv || true
echo "Finished."
date
