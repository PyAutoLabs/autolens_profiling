#!/bin/bash -l
#
# 2026-09 hst-gpu-non-solver-residue PHASE 1 — the A100 trace legs (autolens_profiling#268).
#
# The fixed-lens-light epic ended with ~21 of the 25.4 ms certified Delaunay A100
# call NOT being the solver — but its largest term ("~13.9 ms mesh / mapper /
# weights / imaging / blurring") is attribution ARITHMETIC across two cells, not a
# measurement. Every JAX decomposition this repo owns is ~11 SEPARATELY COMPILED
# prefix programs whose rows move with fusion.
#
# This leg measures where the FUSED PRODUCTION PROGRAM spends its device time: one
# program, one process, one XLA timeline, joined kernel-by-kernel to library source
# through the optimized HLO's stack frame index.
#
# Array tasks
# -----------
#   0  delaunay     --border-relocator cell  the PRODUCTION configuration (see below)
#   1  delaunay     --border-relocator off   what the border relocator costs
#   2  delaunay_nn  --border-relocator cell  the 69 % residue the campaign map quotes
#
# The border relocator, and a corrected premise
# ---------------------------------------------
# The issue assumed "the profiling cells force the relocator on; production ships it
# off". That is FALSE for lensing. autolens_profiling/config/general.yaml declares no
# `inversion` block, so autoconf falls through to the packaged
# PyAutoGalaxy/autogalaxy/config/general.yaml:16, which is `true` (PyAutoArray's own
# default is false, but autogalaxy's wins for autolens). autolens_workspace,
# autolens_workspace_test, HowToLens and euclid_strong_lens_modeling_pipeline all set
# it true. So `--border-relocator cell` IS the production configuration, and task 1
# (`off`) is the counterfactual, not the other way round. Each JSON records the
# RESOLVED boolean and the filename carries it.
#
# Command buffers
# ---------------
# The cell compiles ONE lowering TWICE — with CUDA command buffers as XLA ships them
# (the production program) and with `xla_gpu_enable_command_buffer=""` (the traceable
# one) — times both, and traces the second. This is not optional: with the graphs on,
# every kernel reports `hlo_op=command_buffer_N` and the name-based join recovers only
# ~35 % of device duration instead of 100 %. The on/off wall delta is recorded per leg
# (+0.9 to +1.2 % on the RTX 2060) so the stage rows are never mistaken for the
# production program's own timing.
#
# The certified solver is a HARNESS monkeypatch
# ---------------------------------------------
# Route d comes from a scoped rebinding of
# `inversion_util.reconstruction_positive_only_from`
# (likelihood_breakdown.library_solver_injection). Every other part of the call —
# mapper, F + lambda H, both log determinants, the evidence — is the library's own
# code on the library's own path. Nothing in PyAutoArray was modified. The JSON
# records the patched dotted name and the injected-call counts, and the cell RAISES if
# the injected solver was never reached on the JAX path.
#
# Flags this cell owns (parse_known_args IGNORES unknown ones, so a checkout WITHOUT
# them would run and silently produce a different table — check
# configuration.border_relocator, configuration.trace_calls, configuration.pass_budget
# and configuration.command_buffers_traced in the JSON):
#
#   --mesh {delaunay,delaunay_nn,rectangular}   required
#   --border-relocator {cell,library,off}       cell = True, library = config, off = False
#   --trace-calls 10                            steady calls taken inside the profiler
#   --routes b,d                                the trace is taken on d; b is the pin's reference
#   --config-name hpc_a100_fp64_fixed_light_trace
#
# NOT passed, deliberately: `--pins` and `--source-pixels`. This cell has no `--pins`
# flag (it always asserts route d == route b at rtol 1e-9) and passing one would be
# silently swallowed; and `--source-pixels` is omitted so the fiducial N=1500 applies
# and the output filename matches the RTX legs rather than gaining an `_n1500` suffix.
#
# Every leg starts from an EMPTY JAX compilation cache: a seeded XLA autotune cache
# silently changes kernels (results/notes/xla_autotune_triton_gemm.md — F 4.8 vs
# 25.6 ms on the same code). XLA_FLAGS carries only constant_folding; the
# autotune/Triton flags are left to autonerves' jax_wrapper so this measures the
# library default. The AUTOTUNE_ENTRIES census at the end is the check.
#
# WALL-BASIS:
#   All three array tasks run the one fixed_light_trace script, so no task's --time is
#   justified by a rate measured on something else. That script has NEVER run on an
#   a100, so the row below is declared unmeasured rather than extrapolated from the
#   phase-5 fixed_light_library a100 leg, which is a different program - it compiles
#   the likelihood TWICE (command buffers on, then off), adds a jit_profile per route,
#   and then traces. The 900 s offered below is an over-estimate anchored on the RTX
#   2060 runs of this exact script, which took ~5 minutes end to end at N=1500 while
#   paying ~1 s per likelihood call; the a100 pays ~40x less per call and compiles
#   comparably, so the real wall should sit well under it. A 12 hour budget is what
#   every fiducial breakdown leg of this family carries and leaves ~48x headroom.
#   NOTE for anyone editing this block - check_submits parses any line here that looks
#   like a keyword, a colon and a value as row data, so prose must not contain that
#   shape. An earlier draft wrote the words "a different" then the keyword and a colon
#   mid-sentence, and the gate read it as a malformed row.
#   cell: imaging/fixed_light_trace/hst  device: a100  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 900  headroom: 3.0

#SBATCH -J flt_trace_delaunay_hst
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=12:00:00
#SBATCH --array=0-2
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..) rather
# than hardcoding /mnt/ral/jnightin/autolens_profiling: the canonical RAL checkout
# sits on main with a dirty tree, so this runs from a worktree of the feature
# branch. The -o/-e paths above are relative, so sbatch from inside hpc/batch_gpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

# `python3 -u` would put a flag between `python3` and the script path, which
# `scripts/misc/wall/check_submits.py` cannot read — its cell-coverage rule would
# then pass vacuously on a submit that runs a cell it never saw. Unbuffering through
# the environment keeps the invocation literal and the gate real.
export PYTHONUNBUFFERED=1

MESHES=(delaunay delaunay delaunay_nn)
BORDERS=(cell off cell)
MESH=${MESHES[$SLURM_ARRAY_TASK_ID]}
BORDER=${BORDERS[$SLURM_ARRAY_TASK_ID]}
if [ -z "$MESH" ] || [ -z "$BORDER" ]; then
    echo "FATAL: no (mesh, border) arm for array task ${SLURM_ARRAY_TASK_ID} (expected 0-2)." >&2
    exit 1
fi

# The dataset is gitignored and auto-simulated on first use. Three arms racing to
# write the same dataset/imaging/hst/ would interleave their FITS writes, so it is
# simulated ONCE before submitting; this is the check that it was.
if [ ! -f "$AP_ROOT/dataset/imaging/hst/data.fits" ]; then
    echo "FATAL: dataset/imaging/hst/data.fits missing. Simulate it once before" >&2
    echo "       submitting (concurrent arms must not auto-simulate the same dir)." >&2
    exit 1
fi

# Fresh per-task compilation cache. output/ is gitignored, so these never reach git;
# ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} keeps concurrent arms on the same node
# from sharing one.
export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/fixed_light_trace_${MESH}_${BORDER}_${SLURM_ARRAY_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}"
rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
echo "JAX_COMPILATION_CACHE_DIR=$JAX_COMPILATION_CACHE_DIR (fresh)"

# The profiler's xplane, and the optimized HLO + module proto the cell dumps beside
# it. Under output/ (gitignored) so a disputed census row can be re-derived from the
# text that produced it without a recompile, but nothing reaches git.
TRACE_DIR="$AP_ROOT/output/trace/fixed_light_trace_${MESH}_${BORDER}_${SLURM_ARRAY_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}"
rm -rf "$TRACE_DIR" && mkdir -p "$TRACE_DIR"
echo "TRACE_DIR=$TRACE_DIR (fresh)"

nvidia-smi

echo "=========================================="
date
hostname
echo "Task:           $SLURM_ARRAY_TASK_ID / 2"
echo "Cell:           likelihood_breakdown/imaging/fixed_light_trace"
echo "Dataset:        hst (0.05\"/px)"
echo "Precision:      fp64"
echo "Inversion path: dense (mapping matrices, InversionImagingMapping)"
echo "Source mesh:    $MESH, 1500 vertices (cell fiducial; --source-pixels NOT passed)"
echo "Border reloc:   --border-relocator $BORDER (the cell reports the RESOLVED boolean)"
echo "Routes:         b,d   (trace taken on d)"
echo "Pass budget:    7 (phase 3 zero-fallback budget for this mesh — the PRODUCTION budget)"
echo "Trace calls:    10"
echo "Command bufs:   traced OFF; the ON program is compiled and timed in the same process"
echo "Config name:    hpc_a100_fp64_fixed_light_trace"
echo "TRACE_LEG mesh=$MESH border=$BORDER dataset=hst hardware=hpc_a100_fp64"
echo "Flags:          --mesh $MESH --border-relocator $BORDER --trace-calls 10 --routes b,d --config-name hpc_a100_fp64_fixed_light_trace"

echo "=== source revisions (shared install, untouched) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance ==="
python3 -c "import autoarray, autolens; print('autoarray.__file__ =', autoarray.__file__); print('autoarray.__version__ =', autoarray.__version__); print('autolens.__file__ =', autolens.__file__)"

python3 scripts/imaging/likelihood_breakdown/fixed_light_trace.py \
    --mesh $MESH \
    --border-relocator $BORDER \
    --trace-calls 10 \
    --routes b,d \
    --trace-dir "$TRACE_DIR" \
    --config-name hpc_a100_fp64_fixed_light_trace

# Autotune-cache census. Must be non-fatal: the directory only exists if XLA wrote
# autotune results, and activate.sh's ERR trap fails the job on any non-zero exit
# (the `ls` failure is swallowed by the pipe to `wc -l`). A non-zero count means this
# leg's kernels were chosen by a cache, not by the library default.
echo -n "AUTOTUNE_ENTRIES count="
ls "$JAX_COMPILATION_CACHE_DIR/xla_gpu_per_fusion_autotune_cache_dir" 2>/dev/null | wc -l

echo "Finished."
date
