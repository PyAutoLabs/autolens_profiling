#!/bin/bash -l
#
# PyAutoLens#678 phase B — point-source defaults evidence campaign: A100
# search profiling for searches/multi_start_prodigy/cluster/image_plane_solved x
# simple x fp64.
#
# Cluster tier — feeds the cluster analogue of exp2 (image-plane
# solved-vs-free): solved-centre image-plane gradient MAP factor-graph
# fit. No free image-plane cluster variant exists (forward-solve cost at
# ~0.3 s/call x free per-source centres is wall-time-prohibitive); hence
# the longer wall time here relative to the source-plane cluster cells.

#SBATCH -J search_msp_cluster_image_plane_solved_simple_fp64
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=12:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autolens_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi

echo "=========================================="
date
echo "Cell:       searches/multi_start_prodigy/cluster/image_plane_solved"
echo "Instrument: simple"
echo "Precision:  fp64"

cd $AP_ROOT
python3 scripts/cluster/searches/multi_start_prodigy/image_plane_solved.py \
    --instrument simple \
    --config-name hpc_a100_fp64 \
    --output-dir $AP_ROOT/results/searches/multi_start_prodigy/cluster/image_plane_solved/simple

echo "Finished."
date
