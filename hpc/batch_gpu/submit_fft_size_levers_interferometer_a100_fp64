#!/bin/bash -l
#
# A100 FFT size levers for the interferometer W~ curvature (autolens_profiling#429, PyAutoPulse
# task interferometer_w_tilde_fft_size_levers): pruned padded FFT vs library F at alma /
# alma_high / jvla, then the jvla real-space pixel-scale row (0.01 / 0.015 / 0.02 / 0.025").
# Measurement only. Script: scripts/interferometer/delaunay/fft_size_levers.py.
#
# Libraries: a PRIVATE 2026.10.17.1 stack, never the shared mirror and never HPCPullPyAuto. It
# is one tarball ($FFTLEV_STACK_TGZ: `git archive` of the five library release tags plus this
# branch's autolens_profiling subset, each with a REVISION file) unpacked at job start onto the
# GPU node's local disk, because small-file writes to /mnt/ral crawled during parallel clones
# (2026-10-17). The datasets are read from the canonical RAL checkout ($AP_DATASETS).
#
# Output: $FFTLEV_OUT/delaunay_hpc_a100_fp64_fft_prune.json, committed as
# results/misc/likelihood_breakdown/interferometer/jvla/delaunay_hpc_a100_fp64_fft_prune.json
#
# Submit from a directory holding output/ and error/:  sbatch <this>
#
# WALL-BASIS:
#   cell: interferometer/fft_size_levers/alma_alma_high_jvla  device: a100  precision: fp64
#   source: unmeasured  probe-first: yes  wall: 2400  headroom: 3.0  ref: #320-jvla-a100-breakdown-scaled-to-5-jvla-loads

#SBATCH -J fft_levers_a100
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96gb
#SBATCH --time=3:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err

set -eo pipefail
TGZ="${FFTLEV_STACK_TGZ:-/mnt/ral/jnightin/scratch/fft_levers_stack.tgz}"
AP_DATASETS="${AP_DATASETS:-/mnt/ral/jnightin/profiling/autolens_profiling/dataset/interferometer}"
OUT="${FFTLEV_OUT:-/mnt/ral/jnightin/scratch/fft_levers_results}"
STACK="${TMPDIR:-/tmp}/fft_levers_${SLURM_JOB_ID:-local}"
mkdir -p "$STACK" "$OUT"
trap 'rm -rf "$STACK"' EXIT
tar -xzf "$TGZ" -C "$STACK"
AP_ROOT="$STACK/autolens_profiling"
mkdir -p "$AP_ROOT/dataset/interferometer"
for i in alma alma_high jvla; do ln -sfn "$AP_DATASETS/$i" "$AP_ROOT/dataset/interferometer/$i"; done
source /mnt/ral/jnightin/PyAuto/PyAuto/bin/activate
export PYTHONPATH=$STACK/PyAutoArray:$STACK/PyAutoNerves:$STACK/PyAutoFit:$STACK/PyAutoGalaxy:$STACK/PyAutoLens
export FFTLEV_STACK="$STACK"
export JAX_PLATFORM_NAME=cuda JAX_PLATFORMS=cuda,cpu XLA_PYTHON_CLIENT_PREALLOCATE=false JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=$STACK/numba_cache MPLCONFIGDIR=$STACK/mpl
cd "$AP_ROOT"
hostname
nvidia-smi
for r in PyAutoArray PyAutoNerves PyAutoFit PyAutoGalaxy PyAutoLens autolens_profiling; do echo "$r $(cat $STACK/$r/REVISION)"; done
python3 -u scripts/interferometer/delaunay/fft_size_levers.py --out "$OUT/delaunay_hpc_a100_fp64_fft_prune_${SLURM_JOB_ID}.json"
date
