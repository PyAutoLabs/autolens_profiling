#!/bin/bash -l
#
# A100 likelihood-breakdown profile: imaging/delaunay_nn x hst x fp64.
# DENSE inversion path (mapping matrices).
#
# Batch-64 companion to submit_breakdown_imaging_delaunay_nn_a100_hst_fp64
# (autolens_profiling#219).
# Compile-heavy: every pipeline step is JIT-compiled in isolation and then
# re-compiled under jax.jit(jax.vmap(...)) at batch 64, so wall time is
# dominated by XLA compiles, not the steady-state timing loops.
#
#   --split-setup    four-way split of the inversion-setup block
#   --vmap-batch 64  the batch-64 point, so the amortization curve has a second
#                    knot beyond the Nautilus n_batch=16 reference
#
# --config-name is a free label: _profile_cli only uses it to name the output
# pair (it loads no config file; device info comes from the live process), so
# "hpc_a100_fp64_vmap64" gives this run its own
# results/breakdown/imaging/delaunay_nn_hpc_a100_fp64_vmap64.{json,png} without
# clobbering the batch-16 pair. That stem is outside build_readme.py's
# CONFIG_TAGGED_RE alternation, so the run is deliberately dashboard-invisible
# and lives as a raw artifact for the comparison note.

#SBATCH -J breakdown_imaging_delaunay_nn_hst_fp64_vmap64
#SBATCH --partition=gpu
# Exclusion of euclid-ral-gpu-1 dropped 2026-09-05: MIG mode confirmed Disabled
# on all four GPUs and JAX cuda init verified per GPU from inside an srun; the
# preflight stays as the backstop. Fleet-wide retirement is a separate follow-up.
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=12:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..)
# rather than hardcoding /mnt/ral/jnightin/autolens_profiling: the canonical
# RAL checkout sits on main with a dirty tree, so this runs from a worktree of
# the feature branch. Same pattern as submit_delaunay_nn_benchmark_a100.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi

echo "=========================================="
date
echo "Cell:           likelihood_breakdown/imaging/delaunay_nn"
echo "Instrument:     hst"
echo "Precision:      fp64"
echo "Inversion path: dense (mapping)"
echo "Flags:          --split-setup --vmap-batch 64"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done

cd $AP_ROOT

python3 -u scripts/imaging/likelihood_breakdown/delaunay_nn.py \
    --config-name hpc_a100_fp64_vmap64 \
    --split-setup \
    --vmap-batch 64

echo "Finished."
date
