#!/bin/bash -l
#
#
# 2026-09 matrix-free pixelized-likelihood fiducial leg (autolens_profiling#247).
# A100 likelihood-breakdown profile: imaging/matrix_free x DelaunayNN x hst x fp64.
#
# What this leg measures: the matrix-free evaluation of the pixelized likelihood
# on the SAME fiducial model the imaging/delaunay_nn breakdown cell builds — preconditioned
# CG on (F + lambda H) x = D using operator products only, a matrix-free PDIP for
# positivity, and both log determinants by stochastic Lanczos quadrature — with
# the exact dense comparators (Cholesky solve, NNLS PDIP, the two log-det
# Choleskys, log_evidence_terms) measured in the SAME process, so every ratio and
# every agreement column is a same-run number.
#
# This is NOT a speed play at n = 1500. The 2026-09-11 reconstruction split
# (results/notes/a100_pixelized_baseline_2026_09.md) measured the exact
# unconstrained solve at 1.52-1.58 ms and the 37 ms reconstruction row as 21-22
# PDIP iterations of dense KKT Cholesky. A CG line that only replaces the linear
# solve therefore has ~1.6 ms to beat, not 37 ms, plus the ~2.4 ms of the two
# log-det Choleskys that SLQ actually targets. The deliverable is the reference
# table and, in phase 3, the N_src crossover the --source-pixels sweep finds.
#
#   --mesh delaunay_nn  which cell's model to rebuild
#   --config-name hpc_a100_fp64_matrix_free  output-filename label for this row
#     (deliberately invisible to build_readme.py's CONFIG_TAGGED_RE — this is a
#      reference row, not a dashboard row)
#   --regularization adapt_split  al.reg.AdaptSplit(0.1, 10.0, 0.1) — what
#                                 production pairs Delaunay with, and what the
#                                 _recon_split leg this is compared to passed
#   --slq-probes 4,8,16,32       the Hutchinson probe counts
#   --slq-steps 20,40,80,160,320,640
#                                the Lanczos step counts. Wider than the cell's
#                                own default (20,40,80) on purpose: a 400-pixel
#                                local run measured the SLQ log-det error at
#                                +445 nats at m=20 with a per-probe spread of
#                                only 7.7, i.e. the error is Lanczos-step bias,
#                                not probe noise, on a matrix whose condition
#                                number is ~4e10. Every extra step is one more
#                                batched matvec, which is cheap here, so the leg
#                                traces the bias-vs-steps curve far enough out
#                                to say where (or whether) it crosses the
#                                0.5-nat go bar.
#   --vmap-batch 16              batched re-timing at the Nautilus n_batch
#
# Gate (read off the JSON): device.cache_fresh true, device.hostname the same
# node as its sibling legs, matrix_free.edge_zeroed_active recorded, the PCG rows'
# rel_residual <= cg_tol, matrix-free PDIP converged, pinned_drift carrying the
# in-process Cholesky check against the 2026-09-11 log-dets plus the SLQ error.
#
# Every leg starts from an EMPTY JAX compilation cache: a seeded XLA autotune
# cache silently changes kernels (results/notes/xla_autotune_triton_gemm.md — F
# 4.8 vs 25.6 ms on the same code). XLA_FLAGS carries only constant_folding; the
# autotune/Triton flags are left to autonerves' jax_wrapper so this measures the
# library default.

#SBATCH -J matrix_free_breakdown_delaunay_nn
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=12:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..) rather
# than hardcoding /mnt/ral/jnightin/autolens_profiling: the canonical RAL
# checkout sits on main with a dirty tree, so this runs from a worktree of the
# feature branch. The -o/-e paths above are relative, so sbatch from inside
# hpc/batch_gpu/ (submit_matrix_free_fiducial.sh does the cd for you).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

# Fresh per-job compilation cache. output/ is gitignored, so these never reach
# git; ${SLURM_JOB_ID} keeps concurrent legs on the same node from sharing one.
export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/matrix_free_${SLURM_JOB_ID:-local}"
rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
echo "JAX_COMPILATION_CACHE_DIR=$JAX_COMPILATION_CACHE_DIR (fresh)"

nvidia-smi

echo "=========================================="
date
hostname
echo "Cell:           likelihood_breakdown/imaging/matrix_free"
echo "Instrument:     hst"
echo "Precision:      fp64"
echo "Inversion path: matrix-free (CG + SLQ on the w-tilde sparse operator)"
echo "Source mesh:    Delaunay mesh, Sibson natural-neighbour, 1500 Hilbert vertices"
echo "Config name:    hpc_a100_fp64_matrix_free"
echo "Regularization: al.reg.AdaptSplit(inner_coefficient=0.1, outer_coefficient=10.0, signal_scale=0.1)"
echo "Flags:          --mesh delaunay_nn --config-name hpc_a100_fp64_matrix_free --regularization adapt_split --slq-probes 4,8,16,32 --slq-steps 20,40,80,160,320,640 --vmap-batch 16"

echo "=== source revisions (shared install, untouched) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance ==="
python3 -c "import autoarray, autolens; print('autoarray.__file__ =', autoarray.__file__); print('autoarray.__version__ =', autoarray.__version__); print('autolens.__file__ =', autolens.__file__)"

python3 -u scripts/imaging/likelihood_breakdown/matrix_free.py \
    --mesh delaunay_nn \
    --config-name hpc_a100_fp64_matrix_free \
    --regularization adapt_split \
    --slq-probes 4,8,16,32 \
    --slq-steps 20,40,80,160,320,640 \
    --vmap-batch 16

# Autotune-cache census. Must be non-fatal: the directory only exists if XLA
# wrote autotune results, and activate.sh's ERR trap fails the job on any
# non-zero exit (the `ls` failure is swallowed by the pipe to `wc -l`).
echo -n "AUTOTUNE_ENTRIES count="
ls "$JAX_COMPILATION_CACHE_DIR/xla_gpu_per_fusion_autotune_cache_dir" 2>/dev/null | wc -l

echo "Finished."
date
