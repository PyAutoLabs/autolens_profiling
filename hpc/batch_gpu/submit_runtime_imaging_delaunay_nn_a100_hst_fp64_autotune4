#!/bin/bash -l
#
# A100 likelihood-runtime profile: imaging/delaunay_nn × hst × fp64.
# DENSE inversion path (InversionImagingMapping).
#
# A/B arm: XLA GPU autotuning RE-ENABLED (--xla_gpu_autotune_level=4, XLA's
# default). PyAutoNerves e8d5842 appends --xla_gpu_autotune_level=0 unless
# XLA_FLAGS already names a level; the paired breakdown run shows the dense
# fp64 curvature-matrix GEMM at 25.63 ms with autotuning off vs 4.82 ms on the
# 2026-07-10 rows. This is the runtime-cell arm of that A/B: same cell and
# flags as submit_runtime_imaging_delaunay_nn_a100_hst_fp64, autotuning on
# (autolens_profiling#219).

#SBATCH -J runtime_imaging_delaunay_nn_hst_fp64_autotune4
#SBATCH --partition=gpu
# Exclusion of euclid-ral-gpu-1 dropped 2026-09-05: MIG mode confirmed Disabled
# on all four GPUs and JAX cuda init verified per GPU from inside an srun; the
# preflight stays as the backstop. Fleet-wide retirement is a separate follow-up.
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=4:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..)
# rather than hardcoding /mnt/ral/jnightin/autolens_profiling: the canonical
# RAL checkout sits on main with a dirty tree, so this runs from a worktree of
# the feature branch. Same pattern as submit_delaunay_nn_benchmark_a100.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=4"
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi

echo "=========================================="
date
echo "Cell:           likelihood_runtime/imaging/delaunay_nn"
echo "Instrument:     hst"
echo "Precision:      fp64"
echo "Inversion path: dense"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done

cd $AP_ROOT

# The --vmap-probe step is skipped for this cell: its batch-1 extrapolation
# recommends 64 replicas, which passes the memory budget but fails cuFFT
# batched-plan creation (job 342280, 2026-09-05). With no probe JSON present
# resolve_vmap_batch falls back to the VMAP_BATCH table (16). The failed probe
# is kept as vmap_probe_delaunay_nn_batch64_cufft_failed.json.
echo "--- full timing ---"
python3 -u scripts/imaging/likelihood_runtime/delaunay_nn.py \
    --instrument hst \
    --config-name hpc_a100_fp64_autotune4

echo "Finished."
date
