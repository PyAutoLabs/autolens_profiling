#!/bin/bash -l
#
# 2026-09 source-plane point-source campaign, phase 2c (autolens_profiling#329):
# the A100 row for the forward-vs-reverse gradient-mode crossover. Single-source
# only (the `simple` dataset); nothing under scripts/cluster/.
#
# WHAT THIS MEASURES. The same cell as the RAL CPU submit
# (hpc/batch_cpu/submit_gradient_mode_crossover_point_source_source_ral_cpu_fp64),
# one process, on ONE RAL A100:
#
#   scripts/point_source_source/source_plane/gradient_mode_crossover.py
#      (ladder L5..L19 + L24 x solved/plain lanes; rev vs fwd, single and
#      jit(vmap) B=8; correctness gate before timing; 20 x 20 interleaved;
#      crossover n* per lane x call shape).
#
# CONFIG LABEL. --config-name hpc_a100_fp64. Pinned to euclid-ral-gpu-1 so the
# reference CPU job (euclid-ral-gpu-2, no --gres) has its node to itself.
#
# PRECISION. fp64 only.
#
# LIBRARY. The shared /mnt/ral/jnightin/PyAuto stack AS-IS; equal to the local
# mains on 2026-09-27 -- see the CPU submit's LIBRARY block.
#
# BACKEND. JAX_PLATFORMS=cuda (NOT "cuda,cpu") and JAX_PLATFORM_NAME=cuda; the
# job asserts jax.default_backend()=="gpu". XLA_FLAGS byte-identical to the CPU
# submit's.
#
# Writes results/breakdown/point_source_source/gradient_mode_crossover_hpc_a100_fp64.{json,png}.
#
# WALL-BASIS:
#   Laptop witness (WSL2, 8 threads): gradient_mode_crossover.py at 20 x 20, 14 rung x lane
#   cells, 1906 s process wall (compile-dominated: rev compiles grow to ~110-127 s at L24).
#   A100 compiles run ~2-3x the CPU's (phase 2b), hence the wider headroom.
#   cell: point_source_source/gradient_mode_crossover/simple  device: gpu  precision: fp64
#   source: measured-wall  wall: 1906  ref: laptop-gradient_mode_crossover_local_cpu_fp64  headroom: 3.0

#SBATCH -J gradmode_p2c_gpu
#SBATCH --partition=gpu
#SBATCH --nodelist=euclid-ral-gpu-1
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=3:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Repo root from where this was submitted (hpc/batch_gpu/../..). sbatch from
# inside hpc/batch_gpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent compile cache: compile times are recorded and must be cold.
unset JAX_COMPILATION_CACHE_DIR

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
nvidia-smi --query-gpu=name,driver_version,memory.total,utilization.gpu --format=csv || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "gpus:           ${CUDA_VISIBLE_DEVICES:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cell:           point_source_source/source_plane/gradient_mode_crossover"
echo "Backend:        JAX_PLATFORMS=$JAX_PLATFORMS JAX_PLATFORM_NAME=$JAX_PLATFORM_NAME"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r (shared)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance + backend assertion ==="
python3 -c "
import os, autoarray, autolens, autofit, autogalaxy, jax
for m in (autoarray, autolens, autofit, autogalaxy):
    print(f'{m.__name__}.__file__ =', m.__file__)
    assert os.path.realpath(m.__file__).startswith('/mnt/ral/jnightin/PyAuto/'), f'{m.__name__} not from the shared stack'
print('jax', jax.__version__, jax.devices(), jax.default_backend())
assert jax.default_backend() == 'gpu', 'JAX is not on the GPU'
print('ASSERT OK: GPU backend, libraries from /mnt/ral/jnightin/PyAuto')
" || exit 3

echo "=========================================="
echo "gradient-mode crossover on A100 (20 x 20)"
date
python3 -u scripts/point_source_source/source_plane/gradient_mode_crossover.py --config-name hpc_a100_fp64 --rounds 20 --calls 20

echo "=========================================="
nvidia-smi --query-gpu=name,memory.used --format=csv || true
echo "Finished."
date
