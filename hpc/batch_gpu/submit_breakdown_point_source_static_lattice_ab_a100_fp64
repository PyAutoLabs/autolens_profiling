#!/bin/bash -l
#
# 2026-09 point-source CPU speed-up campaign, phase 3: the GPU regression leg
# for the static step-0 lattice (PyAutoArray#568).
#
# WHAT THIS MEASURES. The same interleaved, in-process four-route A/B as the RAL
# CPU submit (hpc/batch_cpu/submit_breakdown_point_source_static_lattice_ab_ral_cpu_fp64)
# on ONE RAL A100, constant folding disabled only (the production flags):
#
#   scripts/point_source/likelihood_breakdown/static_lattice_ab.py
#     control = flat 69 849-row step-0 table (phase-2 main path, in-job control);
#     exact   = 28 665 exact-float rows;  lattice = 11 859 geometric vertices;
#     library = the FEATURE BRANCH clones (LIBRARY below) -- must self-label
#               library_matches = lattice.
#   Rows: simple solved + plain + vmap-4 of solved; cluster solved + plain.
#   Protocol: 20 rounds x 20 calls. The stop rule rejects phase 3 on any GPU
#   regression, so the question here is lattice/library vs control >= 1.
#
# PRECISION. fp64 only (the PointSolver has no mixed-precision switch).
#
# LIBRARY. Prepends git clones of PyAutoArray and PyAutoLens
# feature/point-source-cpu-p3 to PYTHONPATH (prepare them as in the CPU submit's
# LIBRARY block). The job refuses to run unless autoarray and autolens import
# from those clones.
#
# BACKEND. JAX_PLATFORMS=cuda (NOT "cuda,cpu": a list can silently fall back to
# CPU) and JAX_PLATFORM_NAME=cuda; the job asserts jax.default_backend()=="gpu".
# XLA_FLAGS are byte-identical to the CPU submit's run 1.
#
# WALL-BASIS:
#   Phase-2 A100 job 350587 ran the three-route vertex_dedup_ab cell (20 x 20,
#   simple + cluster); this cell adds a fourth route and a step-0 gate row, so the
#   laptop witness of THIS cell (975 s wall, folding off, 20 x 20, simple + cluster) is
#   the basis, with 2.0 headroom for slower GPU compiles of the cluster HLO.
#   cell: point_source/static_lattice_ab/simple  device: gpu  precision: fp64
#   source: measured-wall  wall: 975  ref: laptop-point_source-static_lattice_ab_laptop_cpu_fp64  headroom: 2.0

#SBATCH -J static_lattice_ab_gpu
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=3:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Repo root from where this was submitted (hpc/batch_gpu/../..). sbatch from
# inside hpc/batch_gpu/.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export AA_BRANCH_SRC="${AA_BRANCH_SRC:-/mnt/ral/jnightin/autolens_profiling_wt/PyAutoArray_point-source-cpu-p3}"
export AL_BRANCH_SRC="${AL_BRANCH_SRC:-/mnt/ral/jnightin/autolens_profiling_wt/PyAutoLens_point-source-cpu-p3}"
for src in "$AA_BRANCH_SRC/autoarray" "$AL_BRANCH_SRC/autolens"; do
    if [ ! -f "$src/__init__.py" ]; then
        echo "FATAL: $src is not a library checkout (see LIBRARY in the header)" >&2
        exit 2
    fi
done
export PYTHONPATH="$AA_BRANCH_SRC:$AL_BRANCH_SRC:$PYTHONPATH"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=1
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding --xla_gpu_autotune_level=0 --xla_gpu_enable_triton_gemm=false"
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"
# No persistent compile cache: compile_s is a gate and must be cold per route.
unset JAX_COMPILATION_CACHE_DIR

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
nvidia-smi --query-gpu=name,driver_version,memory.total,utilization.gpu --format=csv || true
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "gpus:           ${CUDA_VISIBLE_DEVICES:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cell:           point_source/likelihood_breakdown/static_lattice_ab"
echo "Backend:        JAX_PLATFORMS=$JAX_PLATFORMS JAX_PLATFORM_NAME=$JAX_PLATFORM_NAME"
echo "XLA_FLAGS:      $XLA_FLAGS"

echo "=== source revisions ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r (shared)" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "PyAutoArray (branch clone, IMPORTED): $(git -C $AA_BRANCH_SRC rev-parse HEAD 2>&1)"
echo "PyAutoLens  (branch clone, IMPORTED): $(git -C $AL_BRANCH_SRC rev-parse HEAD 2>&1)"
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
echo "AP_ROOT branch: $(git -C $AP_ROOT rev-parse --abbrev-ref HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance + backend assertion ==="
python3 -c "
import os, autoarray, autolens, autofit, autogalaxy, jax
for m in (autoarray, autolens, autofit, autogalaxy):
    print(f'{m.__name__}.__file__ =', m.__file__)
print('jax', jax.__version__, jax.devices(), jax.default_backend())
assert jax.default_backend() == 'gpu', 'JAX is not on the GPU'
assert os.path.realpath(autoarray.__file__).startswith(os.path.realpath(os.environ['AA_BRANCH_SRC'])), 'autoarray not imported from the branch clone'
assert os.path.realpath(autolens.__file__).startswith(os.path.realpath(os.environ['AL_BRANCH_SRC'])), 'autolens not imported from the branch clone'
print('ASSERT OK: GPU backend, autoarray + autolens from the branch clones')
" || exit 3

echo "=========================================="
echo "static-lattice A/B on A100 (20 x 20, simple + cluster)"
date
python3 -u scripts/point_source/likelihood_breakdown/static_lattice_ab.py --config-name hpc_ral_a100_fp64 --rounds 20 --calls 20

echo "=========================================="
nvidia-smi --query-gpu=name,memory.used --format=csv || true
echo "Finished."
date
