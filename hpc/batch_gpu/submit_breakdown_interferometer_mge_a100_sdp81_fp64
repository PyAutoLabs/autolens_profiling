#!/bin/bash -l
#
# A100 likelihood-breakdown profile: interferometer/mge x sdp81 x fp64, DENSE library path + W~ measurement arm.
# autolens_profiling#356 (interferometer likelihood campaign 3/3, phase 4 decision matrix):
# the sdp81 row -- real SDP.81 uv coverage (108,384 vis) on the alma 800x800 @ 0.05" grid,
# simulated lens + source (instruments/interferometer.py "sdp81"), preset mask r3.5. Copied
# from submit_breakdown_interferometer_mge_a100_alma_fp64; only the instrument changes (at 1e5 vis the dense one-shot transform should fit: alma asked 61 GiB at 1M).
# Libraries: the SHARED mirror /mnt/ral/jnightin/PyAuto (activate.sh). A RESOURCE_EXHAUSTED /
# OOM is recorded in the JSON as a result.
#
# Output: results/breakdown/interferometer/sdp81/mge_hpc_a100_fp64.{json,png}
#
# Submit from hpc/batch_gpu/ (the -o/-e paths are relative).

#SBATCH -J breakdown_interferometer_mge_sdp81_fp64
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=2:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..): it runs from
# a RAL worktree of the feature branch, not only the canonical RAL checkout.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PROJECT_PATH="$AP_ROOT"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"

nvidia-smi

echo "=========================================="
date
echo "Cell:           likelihood_breakdown/interferometer/mge"
echo "Instrument:     sdp81"
echo "Precision:      fp64"
echo "Inversion path: dense (mapping) + W~ arm"

cd $AP_ROOT

python3 scripts/interferometer/likelihood_breakdown/mge.py \
    --config-name hpc_a100_fp64 \
    --instrument sdp81 \
    --w-tilde \
    --transform-chunk 4 \
    --vmap-batch 4

echo "Finished."
date
