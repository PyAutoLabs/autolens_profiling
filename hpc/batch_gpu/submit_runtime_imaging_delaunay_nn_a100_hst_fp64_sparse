#!/bin/bash -l
#
# A100 likelihood-runtime profile: imaging/delaunay_nn x hst x fp64, sparse inversion.
# Leg of the 2026-09 pixelized baseline grid (autolens_profiling#241):
# {pixelization, delaunay, delaunay_nn} x {runtime, breakdown} x {dense, sparse},
# twelve legs pinned to one A100 node by submit_baseline_grid.sh. Fiducial tier
# (1500/1521 source pixels, MGE-60, lp [4,2,2]), NOT the #235 production preset;
# the sparse legs are the half-matrix-free comparator for the CG + SLQ work, not
# a production GPU path (production GPU runs fit the plain dataset).
#
#   --instrument hst              explicit; also the cell's module default
#   --config-name hpc_a100_fp64   output-filename label for this row
#   --regularization adapt_split  al.reg.AdaptSplit(0.1, 10.0, 0.1) — what
#                                 production pairs Delaunay with (#232)
#   --sparse                      dataset.apply_sparse_operator() -> w-tilde path
#
# Every leg starts from an EMPTY JAX compilation cache: a seeded XLA autotune
# cache silently changes kernels (results/notes/xla_autotune_triton_gemm.md — F
# 4.8 vs 25.6 ms on the same code), which is the whole reason for this re-run.
# XLA_FLAGS carries only constant_folding; the autotune/Triton flags are left to
# autonerves' jax_wrapper so this measures the library default.
#
# --vmap-probe is deliberately NOT run on the runtime legs: it sys.exit()s before
# the vmap phase, and this grid needs the vmap per-call row. With no probe JSON
# present resolve_vmap_batch falls back to the VMAP_BATCH table (16 at hst).
# For this cell the probe is also actively harmful: its batch-1 extrapolation
# recommends 64 replicas, which passes the memory budget but fails cuFFT
# batched-plan creation (RAL job 342280, 2026-09-05). The failed probe is kept
# as vmap_probe_delaunay_nn_batch64_cufft_failed.json.

#SBATCH -J baseline_runtime_delaunay_nn_sparse
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=12:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..) rather
# than hardcoding /mnt/ral/jnightin/autolens_profiling: the canonical RAL
# checkout sits on main with a dirty tree, so this runs from a worktree of the
# feature branch. The -o/-e paths above are relative, so sbatch from inside
# hpc/batch_gpu/ (submit_baseline_grid.sh does the cd for you).
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

# Fresh per-job compilation cache. output/ is gitignored, so these never reach
# git; ${SLURM_JOB_ID} keeps concurrent legs on the same node from sharing one.
export JAX_COMPILATION_CACHE_DIR="$AP_ROOT/output/jax_cache/baseline_${SLURM_JOB_ID:-local}"
rm -rf "$JAX_COMPILATION_CACHE_DIR" && mkdir -p "$JAX_COMPILATION_CACHE_DIR"
echo "JAX_COMPILATION_CACHE_DIR=$JAX_COMPILATION_CACHE_DIR (fresh)"

nvidia-smi

echo "=========================================="
date
hostname
echo "Cell:           likelihood_runtime/imaging/delaunay_nn"
echo "Instrument:     hst"
echo "Precision:      fp64"
echo "Inversion path: sparse (w-tilde operator, InversionImagingSparse)"
echo "Source mesh:    Delaunay mesh, Sibson natural-neighbour"
echo "Config name:    hpc_a100_fp64"
echo "Regularization: al.reg.AdaptSplit(inner_coefficient=0.1, outer_coefficient=10.0, signal_scale=0.1)"
echo "Flags:          --instrument hst --config-name hpc_a100_fp64 --regularization adapt_split --sparse"

echo "=== source revisions (shared install, untouched) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C /mnt/ral/jnightin/PyAuto/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"

cd $AP_ROOT

echo "=== import provenance ==="
python3 -c "import autoarray, autolens; print('autoarray.__file__ =', autoarray.__file__); print('autoarray.__version__ =', autoarray.__version__); print('autolens.__file__ =', autolens.__file__)"

python3 -u scripts/imaging/likelihood_runtime/delaunay_nn.py \
    --instrument hst \
    --config-name hpc_a100_fp64 \
    --regularization adapt_split \
    --sparse

# Autotune-cache census. Must be non-fatal: the directory only exists if XLA
# wrote autotune results, and activate.sh's ERR trap fails the job on any
# non-zero exit (the `ls` failure is swallowed by the pipe to `wc -l`).
echo -n "AUTOTUNE_ENTRIES count="
ls "$JAX_COMPILATION_CACHE_DIR/xla_gpu_per_fusion_autotune_cache_dir" 2>/dev/null | wc -l

echo "Finished."
date
