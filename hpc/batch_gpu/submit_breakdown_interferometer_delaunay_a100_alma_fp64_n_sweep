#!/bin/bash -l
#
# A100 likelihood-breakdown profile: interferometer/delaunay x alma N-sweep x fp64, sparse (W~) path.
# autolens_profiling#320 (interferometer likelihood campaign 2/3): the Hilbert-1500 Delaunay + AdaptSplit(0.1, 10, 0.1)
# cell on InversionInterferometerSparse, steps = the library's per-evaluation work (no
# transformed-mapping-matrix row), dense InversionInterferometerMapping comparison arm under
# dense_steps where it fits, and the lever sub-rows (solver A/B, F block-size sweep, F kernel
# split, fp32 FFT arm, vmap probe). Harness:
# scripts/misc/likelihood_breakdown/interferometer_pixelized.py.
#
# N sweep at alma (the GPU half of the epic's 3/3 decision matrix): --source-pixels
# 1000, 2500, 4000 (N=1500/1521 is the fiducial alma fp64 job). Rectangular takes the nearest
# square (round(sqrt(N)) per side: 1024 = 32^2, 2500 = 50^2, 4096 = 64^2). Every leg carries the
# solver A/B (PDIP vs certified, standalone on the same system + the full pipeline with both).
#
# Libraries: the SHARED mirror /mnt/ral/jnightin/PyAuto (refreshed by HPCPullPyAuto to the
# 2026-09-26 mains: lever 1 MGE W~ route #575, lever 3 real scatter #577), via activate.sh.
# JAX_ENABLE_X64 is exported explicitly (sbatch does not inherit it); the cell refuses to run
# with x64 off. A RESOURCE_EXHAUSTED / OOM inside the cell is recorded in the JSON as a result.
#
# Output: 
#   results/breakdown/interferometer/n_sweep/delaunay_hpc_a100_fp64_n1000.{json,png}
#   results/breakdown/interferometer/n_sweep/delaunay_hpc_a100_fp64_n2500.{json,png}
#   results/breakdown/interferometer/n_sweep/delaunay_hpc_a100_fp64_n4000.{json,png}
#
# Submit from hpc/batch_gpu/ (the -o/-e paths are relative).

#SBATCH -J bd_intf_del_alma_nsweep
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=4:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

# Derive the repo root from where this was submitted (hpc/batch_gpu/../..): it runs from
# a RAL worktree of the feature branch, not only the canonical RAL checkout.
export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
export PROJECT_PATH="$AP_ROOT"
export PYAUTO_HPC_BASE="${PYAUTO_HPC_BASE:-/mnt/ral/jnightin/PyAuto}"
echo "AP_ROOT=$AP_ROOT"
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export XLA_FLAGS="--xla_disable_hlo_passes=constant_folding"

nvidia-smi

cd $AP_ROOT

echo "=== source revisions (shared mirror) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s\n' "$r" "$(git -C $PYAUTO_HPC_BASE/$r rev-parse HEAD 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
python3 -c "
import importlib.metadata as m, autoarray, autolens, jax
print('autoarray.__file__ =', autoarray.__file__)
print('autolens.__file__ =', autolens.__file__)
print('nufftax', m.version('nufftax'), 'jax', jax.__version__, 'x64', jax.config.x64_enabled)
assert tuple(int(x) for x in m.version('nufftax').split('.')[:2]) >= (0, 6), 'nufftax below the 0.6.1 floor'
"

echo "=========================================="
date
echo "Cell:           likelihood_breakdown/interferometer/delaunay"
echo "Instrument:     alma"
echo "Precision:      fp64"
echo "Leg:            N sweep, --source-pixels 1000"
python3 -u scripts/interferometer/likelihood_breakdown/delaunay.py \
    --instrument alma \
    --config-name hpc_a100_fp64_n1000 \
    --source-pixels 1000 \
    --solver-ab \
    --fp32-fft-arm \
    --batch-size-sweep 64,256 \
    --vmap-batch 16,4 \
    --output-dir $AP_ROOT/results/breakdown/interferometer/n_sweep

echo "=========================================="
date
echo "Cell:           likelihood_breakdown/interferometer/delaunay"
echo "Instrument:     alma"
echo "Precision:      fp64"
echo "Leg:            N sweep, --source-pixels 2500"
python3 -u scripts/interferometer/likelihood_breakdown/delaunay.py \
    --instrument alma \
    --config-name hpc_a100_fp64_n2500 \
    --source-pixels 2500 \
    --solver-ab \
    --fp32-fft-arm \
    --batch-size-sweep 64,256 \
    --vmap-batch 16,4 \
    --output-dir $AP_ROOT/results/breakdown/interferometer/n_sweep

echo "=========================================="
date
echo "Cell:           likelihood_breakdown/interferometer/delaunay"
echo "Instrument:     alma"
echo "Precision:      fp64"
echo "Leg:            N sweep, --source-pixels 4000"
python3 -u scripts/interferometer/likelihood_breakdown/delaunay.py \
    --instrument alma \
    --config-name hpc_a100_fp64_n4000 \
    --source-pixels 4000 \
    --solver-ab \
    --fp32-fft-arm \
    --batch-size-sweep 64,256 \
    --vmap-batch 16,4 \
    --output-dir $AP_ROOT/results/breakdown/interferometer/n_sweep

echo "Finished."
date
