#!/bin/bash -l
#
# 2026 linear-solver programme, phase 3a (autolens_profiling#393): A100 parity of the solver
# corpus. Runs the existing accuracy cell (scripts/lens/solver/accuracy.py --device gpu) over
# all 81 captured (Q, q) systems on one A100, fp64, and scores every candidate against the
# stored CPU fnnls references (flux_inactive_rel, amplitude agreement, iterations).
#
# LIBRARY. A PRIVATE checkout of the five libraries at tag 2026.10.7.1 (contains
# PyAutoArray#595), cloned under /mnt/ral/jnightin/PyAuto_wt/linear-solver-p3/. The shared
# mirror /mnt/ral/jnightin/PyAuto is NOT synced for this (euclid_dr1 depends on it); only its
# venv is reused via activate.sh. The private checkouts are prepended to PYTHONPATH after
# activate.sh, and the job refuses to run unless every auto* module imports from
# $PYAUTO_HPC_BASE.
#
# HAZARD. Nerves at 2026.10.7.1 excludes jax 0.10.* at install time (CPU batched-LAPACK
# deadlock, Heart#274); the shared venv carries jax 0.10.2. This job performs no CPU batched
# solve (the references are stored), and the jax/jaxlib versions are printed below.
#
# BACKEND. accuracy.py's --device gpu pins JAX_PLATFORMS=cuda before jax is imported; the
# exports below say the same and the provenance block asserts jax.default_backend()=="gpu".

# WALL-BASIS:
#   The laptop CPU run of this cell over all 81 systems took 16 s (ledger phase 2,
#   2026-09-30); the A100 adds one compile per JAX candidate and system shape (n = 60 for all
#   81). No A100 measurement exists yet, so the 2 h budget is a probe-sized ceiling.
#   cell: lens/accuracy/corpus  device: gpu  precision: fp64
#   source: unmeasured  probe-first: yes

#SBATCH -J lens_solver_accuracy_gpu
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32gb
#SBATCH --time=2:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT="$(cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")}/../.." && pwd)"
echo "AP_ROOT=$AP_ROOT"
export PYAUTO_HPC_BASE=/mnt/ral/jnightin/PyAuto_wt/linear-solver-p3
source $AP_ROOT/activate.sh
export PYTHONPATH=$PYAUTO_HPC_BASE/PyAutoNerves:$PYAUTO_HPC_BASE/PyAutoFit:$PYAUTO_HPC_BASE/PyAutoArray:$PYAUTO_HPC_BASE/PyAutoGalaxy:$PYAUTO_HPC_BASE/PyAutoLens:$PYTHONPATH

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NPROC=${SLURM_CPUS_PER_TASK:-8}
export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=1
export NUMBA_CACHE_DIR=$AP_ROOT/output/numba_cache_${SLURM_JOB_ID:-local}
mkdir -p "$NUMBA_CACHE_DIR" "$MPLCONFIGDIR"

RESULTS_DIR=$AP_ROOT/results/lens/solver
# A source checkout at a release tag still stamps al.__version__ = 2026.8.17.1 (the release
# workflow writes the real version only into the built package), so the cell's own artefact
# name would overwrite the committed _v2026.8.17.1 rows. Write to a per-job directory under the
# gitignored output/ and copy the pair to the tag's name; the JSON's
# device.provenance.library_revisions carries the tag SHAs.
TAG=2026.10.7.1
RUN_DIR=$AP_ROOT/output/lens_solver_accuracy_${SLURM_JOB_ID:-local}
mkdir -p "$RUN_DIR" "$RESULTS_DIR"

echo "=========================================="
date
hostname
lscpu | grep 'Model name' || true
nvidia-smi -L || true
nvidia-smi --query-gpu=name,driver_version,memory.total,utilization.gpu --format=csv || true
echo "gpus:           ${CUDA_VISIBLE_DEVICES:-unset}"
echo "partition:      ${SLURM_JOB_PARTITION:-unset}"
echo "cpus-per-task:  ${SLURM_CPUS_PER_TASK:-unset}"
echo "loadavg:        $(cat /proc/loadavg)"
echo "Cell:           lens/solver/accuracy.py --device gpu (all corpus groups, default candidates)"
echo "PYAUTO_HPC_BASE: $PYAUTO_HPC_BASE"
echo "PYTHONPATH:     $PYTHONPATH"

echo "=== source revisions (private base) ==="
for r in PyAutoNerves PyAutoFit PyAutoArray PyAutoGalaxy PyAutoLens; do
    printf '%-14s %s  %s\n' "$r" "$(git -C $PYAUTO_HPC_BASE/$r rev-parse HEAD 2>&1)" \
        "$(git -C $PYAUTO_HPC_BASE/$r describe --tags 2>&1)"
done
echo "AP_ROOT rev:   $(git -C $AP_ROOT rev-parse HEAD 2>&1)"
python3 -c 'import jax, jaxlib; print("jax", jax.__version__, "jaxlib", jaxlib.__version__)'

cd $AP_ROOT

echo "=== import provenance ==="
python3 - <<'PYEOF' || exit 3
import os
import autonerves, autofit, autoarray, autogalaxy, autolens, jax, jaxlib, numpy
base = os.environ["PYAUTO_HPC_BASE"].rstrip("/") + "/"
for m in (autonerves, autofit, autoarray, autogalaxy, autolens):
    print(f"{m.__name__:<11} {getattr(m, '__version__', '?'):<12} {m.__file__}")
    if not m.__file__.startswith(base):
        raise SystemExit(f"REFUSING: {m.__name__} from {m.__file__}, not {base}")
print("jax", jax.__version__, "jaxlib", jaxlib.__version__, "numpy", numpy.__version__, jax.devices())
if jax.default_backend() != "gpu":
    raise SystemExit(f"REFUSING: JAX backend is {jax.default_backend()}, not gpu")
PYEOF

echo "=========================================="
echo "RUN accuracy.py --device gpu -> ${RUN_DIR}"
date
python3 scripts/lens/solver/accuracy.py --device gpu --output-dir "$RUN_DIR"

echo "=== summary JSON post-check (aggregates finite) ==="
python3 - "$RUN_DIR" <<'PYEOF' || exit 3
import json, math, sys
from pathlib import Path
import autolens as al
path = Path(sys.argv[1]) / f"accuracy_summary_all_gpu_v{al.__version__}.json"
d = json.load(open(path))
bad = []
for name, agg in d["aggregates"].items():
    if agg["n_nonfinite"]:
        bad.append(f"{name}: n_nonfinite={agg['n_nonfinite']}")
    for k, v in agg.items():
        if isinstance(v, float) and not math.isfinite(v):
            bad.append(f"{name}.{k}={v}")
print("device:", d["device"].get("platform", d["device"]))
if bad:
    raise SystemExit("NON-FINITE aggregates in " + str(path) + ": " + "; ".join(bad))
print("OK", path, "candidates", list(d["aggregates"]))
PYEOF

STAMP=$(python3 -c 'import autolens as al; print(al.__version__)')
for ext in json png; do
    cp "$RUN_DIR/accuracy_summary_all_gpu_v${STAMP}.${ext}" \
        "$RESULTS_DIR/accuracy_summary_all_gpu_v${TAG}.${ext}"
done
ls -l "$RESULTS_DIR"/accuracy_summary_all_gpu_v${TAG}.*

echo "=========================================="
echo "loadavg: $(cat /proc/loadavg)"
nvidia-smi --query-gpu=name,memory.used --format=csv || true
echo "Finished."
date
