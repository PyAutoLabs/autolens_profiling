#!/bin/bash -l
#
# Inference programme Phase 2 (issue #149) — mainline af.NSS A100 scan,
# wave 1 arm B: searches/nss/imaging/mge x hst x fp64, inner steps = 45.
#
# ARM: n_live 200, num_mcmc_steps 45, num_delete 50, dlogz -3, seed 42,
#      unchunked (A100 80GB fits the unchunked inner step).
#      Only num_mcmc_steps moves vs the 2026-08-23 anchor row
#      (results/searches/nss/imaging/mge/hst/hpc_hpc_a100_fp64.json,
#      inner=5, sampler wall 839.6 s, logZ 31698.85, max logL 31786.62).
#
# HYPOTHESIS [H2.1] (PROGRAMME.md §4 Phase 2): the +8.4-nat logZ bias vs the
#      Nautilus reference (31690.5) comes from slice-MCMC under-mixing. The
#      MGE cell has d = 15 free parameters; this arm is 3d = 45, the upper
#      inner-steps rung of the pre-registered grid. Read together with the
#      inner30 arm it separates "2d is enough" from "the bias keeps shrinking
#      with more mixing": if inner45's logZ sits at inner30's, mixing has
#      saturated and 2d is the operating point; if it is still falling, the
#      bias is not fully mixing-limited at 2d.
#
# WALL-TIME ESTIMATE: NSS inner cost is ~linear in num_mcmc_steps, so scale the
#      anchor's 839.6 s sampler wall by 45/5 = 9x -> ~7556 s, plus ~45 s viz
#      (5 calls) and ~120 s compile margin -> ~7721 s (~2 h 9 m).
#      --time is set to ~1.5x that (~3 h 13 m), rounded up to 3:30:00.
#      Well under 6 h, so this arm stays in wave 1.
#
# ARTIFACT ISOLATION: --config-name carries the arm label. It sets BOTH the
#      results basename (resolve_output_paths in _profile_cli.py) and the
#      af.NSS search ``name`` (build_nss in scripts/misc/searches/_samplers.py),
#      so this arm writes hpc_hpc_a100_fp64_inner45.json and fits under its own
#      output/ directory — it can neither clobber the anchor's JSON nor resume
#      the anchor's completed fit. (num_mcmc_steps is also an NSS
#      __identifier_fields__ entry, so the autofit identifier differs too.)

# WALL-BASIS: — one row per cell this submit runs. See scripts/misc/wall/README.md.
#   `rates` cites a step rate measured on THAT cell (wall/rates.py); an MGE rate
#   can never stand in for a pixelized cell — that is what killed RAL job 340576.
#   cell: imaging/mge/hst  device: a100  precision: fp64
#   source: unmeasured  probe-first: yes
#   NOTE: no step rate has been measured on this cell. Run one short arm
#   before trusting --time; a truncated arm still measures s/step.

#SBATCH -J search_nss_imaging_mge_hst_fp64_inner45
#SBATCH --partition=gpu
# Node exclusion (2026-08-28): euclid-ral-gpu-1 carries a MIG-mode A100 with
# no instances that SLURM still hands out as a plain gpu:A100 — see
# _gpu_preflight.sh, which stays armed as the backstop.
#SBATCH --exclude=euclid-ral-gpu-1
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=3:30:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autolens_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

# Phase 2 scan knobs. Every value is stated explicitly (including the ones that
# match the builder defaults in searches/_samplers.py) so the arm is readable
# from this file alone and cannot drift if a default changes.
export SEARCHES_NSS_N_LIVE=200
export SEARCHES_NSS_NUM_MCMC_STEPS=45
export SEARCHES_NSS_NUM_DELETE=50
export SEARCHES_NSS_TERMINATION=-3.0
export SEARCHES_NSS_SEED=42
# chunk_size deliberately unset: the A100 80GB runs the unchunked inner step,
# as the anchor row did. (It is also the one NSS knob absent from
# __identifier_fields__, so it must never be used to distinguish arms.)

nvidia-smi

echo "=========================================="
date
echo "Cell:       searches/nss/imaging/mge"
echo "Instrument: hst"
echo "Precision:  fp64"
echo "Arm:        inner45 (num_mcmc_steps=45 = 3d), H2.1"

cd $AP_ROOT
python3 scripts/imaging/searches/nss/mge.py \
    --instrument hst \
    --config-name hpc_a100_fp64_inner45 \
    --output-dir $AP_ROOT/results/searches/nss/imaging/mge/hst

echo "Finished."
date
