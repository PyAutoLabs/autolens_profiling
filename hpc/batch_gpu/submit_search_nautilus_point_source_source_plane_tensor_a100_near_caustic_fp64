#!/bin/bash -l
#
# PyAutoLens#678 phase B — point-source defaults evidence campaign: A100
# search profiling for searches/nautilus/point_source/source_plane_tensor x
# near_caustic x fp64.
#
# Feeds exp5 (near-caustic): free-centre jacobian-weighted tensor fit
# near the tangential caustic (source_centre_caustic_fraction: 0.95),
# where naive chi-squared weighting is most likely to break down.

#SBATCH -J search_nautilus_point_source_source_plane_tensor_near_caustic_fp64
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64gb
#SBATCH --time=2:00:00
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autolens_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORM_NAME=cuda
export JAX_PLATFORMS=cuda,cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_ENABLE_X64=True
export NUMBA_CACHE_DIR=/tmp/numba_cache
export MPLCONFIGDIR=/tmp/matplotlib

nvidia-smi

echo "=========================================="
date
echo "Cell:       searches/nautilus/point_source/source_plane_tensor"
echo "Instrument: near_caustic"
echo "Precision:  fp64"

cd $AP_ROOT
python3 scripts/point_source/searches/nautilus/source_plane_tensor.py \
    --instrument near_caustic \
    --config-name hpc_a100_fp64 \
    --output-dir $AP_ROOT/results/searches/nautilus/point_source/source_plane_tensor/near_caustic

echo "Finished."
date
